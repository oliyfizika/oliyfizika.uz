{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "onlinefizika",
      "public": "tools/onlinefizika-redirect",
      "redirects": [
        {
          "source": "/:path*",
          "destination": "https://oliyfizika.uz/:path",
          "type": 301
        }
      ]
    }
  ]
}
