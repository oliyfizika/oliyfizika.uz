rules_version = '2';

// ============================================================================
// OliyFizika.uz — Firestore Security Rules (Phase 19 — Admin System 1.0 + security; Phase 19C — XP integrity)
//
// DIQQAT: bu fayl repositoryda saqlanadi, avtomatik DEPLOY QILINMAYDI.
// Production'ga faqat loyiha egasi tekshirib, qo'lda qo'yadi (Firebase Console → Firestore → Rules
// yoki `firebase deploy --only firestore:rules`).
//
// Model:
//   users/{uid}
//     • egasi o'qiydi; admin hammasini o'qiydi/sanaydi.
//     • egasi yaratadi — faqat standart qiymatlar bilan (xp 0, level 1, fullAccess false, role/mockTestsAccess YO'Q).
//     • egasi yangilaydi — faqat firstName, lastName, fullName, lastActiveAt
//       (+ eski hisoblarda YO'Q maydonlarni standart qiymat bilan to'ldirish — ensureUserProfile);
//       XP: faqat users/{uid}/xpGrants/L{lessonId} grant hujjati bilan BIR atomik yozuvda (Phase 19C):
//       bitta mavzu — bitta grant (deterministik ID, o'zgarmas) — XP bir martadan ortiq berilmaydi.
//     • admin yangilaydi — faqat role ('user'|'admin'), fullAccess, mockTestsAccess (bool).
//       Admin o'z role maydonini o'zgartira olmaydi (oxirgi adminni tasodifan yo'qotmaslik).
//     • o'chirish — faqat admin.
//   results/{id}
//     • faqat o'z uid'i bilan yaratiladi; maydonlar/turlar/percent–score–passed mosligi tekshiriladi.
//     • egasi va admin o'qiydi; update — hech kim; delete — faqat admin.
//   users/{uid}/xpGrants/L{lessonId}   (Phase 19C — XP audit + idempotentlik)
//     • faqat egasi yaratadi, users.xp/level/lastXpGrant yangilanishi bilan BIRGA (batch/tranzaksiya);
//       natija (results/{resultId}) shu foydalanuvchiniki, shu mavzu, passed va foizi XP'ga mos bo'lishi shart.
//     • egasi va admin o'qiydi; update/delete — hech kim (immutable).
//   Qolgan barcha yo'llar — yopiq (default deny).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- umumiy
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function authEmail() {
      return request.auth.token.get('email', '');
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // Admin: users/{auth.uid}.role == 'admin'. `role` maydonini faqat admin yozishi mumkin (pastda).
    function isAdmin() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.get('role', 'user') == 'admin';
    }

    // ---------------------------------------------------------------- users
    // js/services/xp-service.js dagi LEVELS jadvali bilan aynan bir xil.
    function levelFor(xp) {
      return xp >= 4000 ? 10
        : xp >= 3000 ? 9
        : xp >= 2300 ? 8
        : xp >= 1700 ? 7
        : xp >= 1200 ? 6
        : xp >= 800 ? 5
        : xp >= 500 ? 4
        : xp >= 250 ? 3
        : xp >= 100 ? 2
        : 1;
    }

    function okName(d, key) {
      return !(key in d) || (d[key] is string && d[key].size() <= 100);
    }

    function okNames(d) {
      return okName(d, 'firstName') && okName(d, 'lastName') && okName(d, 'fullName');
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Yangi profil: ensureUserProfile() yozadigan maydonlar, faqat standart qiymatlar bilan.
    function validNewProfile(d) {
      return d.keys().hasOnly(['fullName', 'firstName', 'lastName', 'email', 'xp', 'level',
                               'fullAccess', 'createdAt', 'lastActiveAt'])
        && okNames(d)
        && (!('email' in d) || d.email == authEmail())
        && (!('xp' in d) || d.xp == 0)
        && (!('level' in d) || d.level == 1)
        && (!('fullAccess' in d) || d.fullAccess == false)
        && (!('createdAt' in d) || d.createdAt == request.time)
        && (!('lastActiveAt' in d) || d.lastActiveAt == request.time);
    }

    // ensureUserProfile() eski hujjatda "bo'sh" deb hisoblaydigan holat: yo'q, null yoki ''.
    function wasBlank(key) {
      return !(key in resource.data) || resource.data[key] == null || resource.data[key] == '';
    }

    // Himoyalangan maydon faqat bo'sh bo'lsa va faqat standart qiymat bilan to'ldirilishi mumkin.
    function backfillOnly(key, value) {
      return !(key in changedKeys()) || (wasBlank(key) && request.resource.data[key] == value);
    }

    // Egasi: ism-familiya, faollik vaqti va (eski hisoblarda) yo'q maydonlarni to'ldirish.
    function ownerProfileUpdate() {
      return changedKeys().hasOnly(['firstName', 'lastName', 'fullName', 'lastActiveAt',
                                    'email', 'xp', 'level', 'fullAccess', 'createdAt'])
        && okNames(request.resource.data)
        && (!('lastActiveAt' in changedKeys()) || request.resource.data.lastActiveAt == request.time)
        && backfillOnly('email', authEmail())
        && backfillOnly('xp', 0)
        && backfillOnly('level', 1)
        && backfillOnly('fullAccess', false)
        && backfillOnly('createdAt', request.time);
    }

    // ---------------------------------------------------------------- XP (Phase 19C)
    // Mukofot identifikatori: users/{uid}/xpGrants/L{lessonId} — mavjud semantika: mavzu uchun XP faqat
    // birinchi muvaffaqiyatli topshirishda beriladi. Grant hujjati o'zgarmas, shuning uchun ikkinchi marta
    // yaratib bo'lmaydi (parallel so'rovlarda ham — ikkinchi commit hujjatni mavjud deb ko'radi va rad etiladi).
    function grantPath(uid, grantId) {
      return /databases/$(database)/documents/users/$(uid)/xpGrants/$(grantId);
    }

    function resultPath(resultId) {
      return /databases/$(database)/documents/results/$(resultId);
    }

    // js/services/xp-service.js calculateXP bilan bir xil: 100% → 20, ≥90% → 15, ≥80% → 10.
    function xpFor(percent) {
      return percent == 100 ? 20 : percent >= 90 ? 15 : percent >= 80 ? 10 : 0;
    }

    // Egasi: XP faqat yangi grant bilan bir atomik yozuvda oshadi (xp = grant.newXp, level = levelFor(xp)).
    function ownerXpAward(userId) {
      return changedKeys().hasOnly(['xp', 'level', 'lastXpGrant'])
        && request.resource.data.lastXpGrant is string
        && request.resource.data.lastXpGrant.matches('L[0-9]{1,3}')
        && !exists(grantPath(userId, request.resource.data.lastXpGrant))
        && existsAfter(grantPath(userId, request.resource.data.lastXpGrant))
        && request.resource.data.xp == getAfter(grantPath(userId, request.resource.data.lastXpGrant)).data.newXp
        && resource.data.get('xp', 0) == getAfter(grantPath(userId, request.resource.data.lastXpGrant)).data.previousXp
        && request.resource.data.level == levelFor(request.resource.data.xp);
    }

    // Grant: o'z natijasiga bog'langan, XP miqdori natija foiziga mos, users bilan birga yoziladi.
    function validGrant(userId, grantId) {
      let g = request.resource.data;
      let result = getAfter(resultPath(g.resultId)).data;
      let userAfter = getAfter(userPath(userId)).data;
      return g.keys().hasOnly(['uid', 'lessonId', 'resultId', 'percent', 'xp', 'previousXp', 'newXp', 'level', 'createdAt'])
        && g.keys().hasAll(['uid', 'lessonId', 'resultId', 'percent', 'xp', 'previousXp', 'newXp', 'level', 'createdAt'])
        && g.uid == userId
        && g.lessonId is int && g.lessonId >= 1 && g.lessonId <= 100
        && grantId == 'L' + string(g.lessonId)
        && g.resultId is string && g.resultId.size() > 0 && g.resultId.size() <= 64
        && result.uid == userId
        && result.lessonId == g.lessonId
        && result.passed == true
        && result.percent == g.percent
        && g.xp == xpFor(g.percent) && g.xp > 0
        && g.previousXp == get(userPath(userId)).data.get('xp', 0)
        && g.newXp == g.previousXp + g.xp
        && g.level == levelFor(g.newXp)
        && userAfter.xp == g.newXp
        && userAfter.level == g.level
        && userAfter.lastXpGrant == grantId
        && g.createdAt == request.time;
    }

    // Admin: faqat kirish huquqlari. O'z role maydonini o'zgartira olmaydi.
    function adminAccessUpdate(userId) {
      return isAdmin()
        && changedKeys().hasOnly(['role', 'fullAccess', 'mockTestsAccess'])
        && (!('role' in changedKeys())
            || (request.resource.data.role in ['user', 'admin'] && userId != request.auth.uid))
        && (!('fullAccess' in changedKeys()) || request.resource.data.fullAccess is bool)
        && (!('mockTestsAccess' in changedKeys()) || request.resource.data.mockTestsAccess is bool);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && validNewProfile(request.resource.data);
      allow update: if (isOwner(userId) && (ownerProfileUpdate() || ownerXpAward(userId)))
                    || adminAccessUpdate(userId);
      allow delete: if isAdmin();

      // XP mukofotlari jurnali (immutable): egasi o'qiydi/yaratadi, admin o'qiydi.
      match /xpGrants/{grantId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && validGrant(userId, grantId);
        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------- results
    function okString(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }

    // js/services/result-service.js yozadigan sxema. percent = Math.round(score / total * 100)
    // butun sonlarda tekshiriladi: |percent·total − score·100| ≤ total / 2.
    function validResult(d) {
      return d.keys().hasOnly(['uid', 'fullName', 'email', 'phone', 'lessonId', 'lessonTitle', 'course',
                               'score', 'totalQuestions', 'percent', 'passed', 'attempt', 'completedAt'])
        && d.keys().hasAll(['uid', 'lessonId', 'score', 'totalQuestions', 'percent', 'passed', 'completedAt'])
        && d.uid == request.auth.uid
        && d.lessonId is number
        && d.score is int && d.totalQuestions is int && d.percent is int
        && d.totalQuestions > 0 && d.totalQuestions <= 500
        && d.score >= 0 && d.score <= d.totalQuestions
        && d.percent >= 0 && d.percent <= 100
        && (d.percent * d.totalQuestions - d.score * 100) * 2 <= d.totalQuestions
        && (d.percent * d.totalQuestions - d.score * 100) * 2 >= 0 - d.totalQuestions
        && d.passed == (d.percent >= 80)
        && d.completedAt == request.time
        && (!('attempt' in d) || (d.attempt is int && d.attempt >= 1))
        && (!('email' in d) || d.email == authEmail())
        && okString(d, 'fullName', 200)
        && okString(d, 'phone', 40)
        && okString(d, 'lessonTitle', 300)
        && okString(d, 'course', 60);
    }

    match /results/{resultId} {
      allow create: if signedIn() && validResult(request.resource.data);
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // >>> attestation-physics (generated — tools/attestatsiya-fizika/rules/build_rules.py)

    // ============================================================================
    // ATTESTATSIYA → FIZIKA (Attestatsiya 2-bosqich) — FAQAT yangi kolleksiyalar.
    // Yuqoridagi users / xpGrants / results qoidalari O'ZGARTIRILMAGAN. Pedagogika Firestore ishlatmaydi.
    // Generator: tools/attestatsiya-fizika/rules/build_rules.py  ·  Hujjat: docs/attestatsiya-fizika/08_security_report.md
    //
    //   attestationPhysicsSettings/config                      accessMode open|paid, timezone, limitlar
    //   attestationPhysicsQuestions/{qid}                      public savol (javobsiz) — faqat published kun
    //   attestationPhysicsQuestions/{qid}/private/answer       javob + yechim — FAQAT admin
    //   attestationPhysicsDailyTests/{testId}                  Day meta; draft — faqat admin
    //     /versions/v{N}   public snapshot (javobsiz)          — published bo'lsa
    //     /keys/v{N}       javob kaliti (ro'yxat)              — o'z urinishini TOPSHIRGANDAN keyin yoki yechim vaqtida
    //     /solutions/v{N}  to'liq yechimlar                    — faqat request.time >= solutionAvailableAt
    //   attestationPhysicsAttempts/{uid}__{testId}             1 ta rasmiy urinish: start → submit → grade
    //
    // Baholash ishonchli: klient yozgan correctAnswers/wrongAnswers/unanswered/scorePercent/correctIds qiymatlari
    // Rules ichida kalit (keys/v{N}) bilan map.diff() orqali solishtiriladi — noto'g'ri qiymat rad etiladi. Javoblar grade'dan
    // OLDIN (submit) qulflanadi, kalit faqat submit'dan keyin o'qiladi — oracle hujumi yo'q.
    // Hech narsa o'chirilmaydi: barcha delete — false.
    // ============================================================================

    function attSettingsPath() {
      return /databases/$(database)/documents/attestationPhysicsSettings/config;
    }

    function attTestPath(testId) {
      return /databases/$(database)/documents/attestationPhysicsDailyTests/$(testId);
    }

    function attTest(testId) {
      return get(attTestPath(testId)).data;
    }

    function attAttemptPath(attemptId) {
      return /databases/$(database)/documents/attestationPhysicsAttempts/$(attemptId);
    }

    // OPEN: har bir autentifikatsiyadan o'tgan foydalanuvchi. PAID: admin yoki users/{uid}.attestationAccess == true
    // (attestationAccess ni foydalanuvchi o'zi yoza olmaydi — users qoidalaridagi hasOnly ro'yxatlarida yo'q).
    function attCanAccess() {
      return signedIn() && (
        isAdmin()
        || get(attSettingsPath()).data.get('accessMode', 'closed') == 'open'
        || get(userPath(request.auth.uid)).data.get('attestationAccess', false) == true
      );
    }

    // published va archived — foydalanuvchiga ko'rinadi; draft — yo'q.
    function attVisible(t) {
      return t.published == true && t.status in ['published', 'archived'];
    }

    function attSolutionOpen(t) {
      return attVisible(t) && t.solutionAvailableAt is timestamp && request.time >= t.solutionAvailableAt;
    }

    function attVersionId(n) {
      return 'v' + string(n);
    }

    // ---------------------------------------------------------------- settings
    function attValidSettings(d) {
      return d.keys().hasAll(['accessMode', 'timezone', 'totalDays'])
        && d.accessMode in ['open', 'paid']
        && d.timezone == 'Asia/Tashkent'
        && d.totalDays is int && d.totalDays >= 1 && d.totalDays <= 100
        && (!('figureBackend' in d) || d.figureBackend in ['storage', 'firestore'])
        && !('courseStartDate' in d);
    }

    match /attestationPhysicsSettings/{docId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && docId == 'config' && attValidSettings(request.resource.data);
      allow delete: if false;
    }

    // ---------------------------------------------------------------- question bank
    // Public hujjatda javob/yechim maydonlari bo'lishi taqiqlangan (admin xatosidan ham himoya).
    function attNoSecrets(d) {
      return !('correctAnswer' in d) && !('solution' in d) && !('answers' in d)
        && !('bookAnswer' in d) && !('solutionResult' in d) && !('review' in d);
    }

    match /attestationPhysicsQuestions/{qid} {
      allow get: if isAdmin() || (attCanAccess() && attVisible(attTest(resource.data.testId)));
      allow list: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.id == qid && attNoSecrets(request.resource.data);
      allow delete: if false;

      match /private/{docId} {
        allow read: if isAdmin();
        allow create, update: if isAdmin() && docId == 'answer' && request.resource.data.id == qid;
        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------- daily tests
    function attValidTestShape(d, testId) {
      return d.id == testId
        && d.dayNumber is int && d.dayNumber >= 1 && d.dayNumber <= 100
        && d.questionIds is list && d.questionCount == d.questionIds.size()
        && d.questionCount >= 1 && d.questionCount <= 40
        // 3-bosqich: vaqt chegarasi yo'q — timeLimitSeconds null (maydon kelajak uchun saqlanadi)
        && (d.timeLimitSeconds == null || (d.timeLimitSeconds is int && d.timeLimitSeconds >= 60))
        && d.currentVersion is int && d.currentVersion >= 1
        && d.status in ['draft', 'published', 'archived']
        && d.published is bool;
    }

    function attContentUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['id', 'dayNumber', 'section', 'questionIds', 'questionCount', 'publishedAt', 'publishedBy']);
    }

    function attVersionReady(testId, n) {
      return exists(/databases/$(database)/documents/attestationPhysicsDailyTests/$(testId)/versions/$(attVersionId(n)))
        && exists(/databases/$(database)/documents/attestationPhysicsDailyTests/$(testId)/keys/$(attVersionId(n)))
        && exists(/databases/$(database)/documents/attestationPhysicsDailyTests/$(testId)/solutions/$(attVersionId(n)));
    }

    function attValidTestUpdate(testId) {
      let o = resource.data;
      let n = request.resource.data;
      return attValidTestShape(n, testId) && (
        // draft tahriri (publish emas)
        (o.status == 'draft' && n.status == 'draft' && n.published == false
          && n.publishedAt == null && n.solutionAvailableAt == null)
        // PUBLISH (admin push): faqat to'liq tayyor versiya bilan
        || (o.status == 'draft' && n.status == 'published' && n.published == true
          && n.publishedAt == request.time && n.publishedBy == request.auth.uid
          && n.solutionAvailableAt is timestamp && n.solutionAvailableAt > request.time
          && n.questionIds == o.questionIds && n.currentVersion == o.currentVersion
          && attVersionReady(testId, n.currentVersion))
        // published: kontent qulflangan; vaqt limiti, yechim vaqti, xabar va YANGI versiya (+1) mumkin
        || (o.status == 'published' && n.status == 'published' && n.published == true && attContentUnchanged()
          && n.solutionAvailableAt is timestamp
          && (n.currentVersion == o.currentVersion
              || (n.currentVersion == o.currentVersion + 1 && attVersionReady(testId, n.currentVersion))))
        // ARCHIVE: yashiriladi, o'chirilmaydi
        || (o.status == 'published' && n.status == 'archived' && n.published == true && attContentUnchanged()
          && n.archivedAt == request.time && n.currentVersion == o.currentVersion
          && n.solutionAvailableAt == o.solutionAvailableAt)
        // UNARCHIVE (admin): archived → draft. Faqat status va published o'zgaradi; versiya, savollar,
        // publishedAt, solutionAvailableAt va boshqa barcha maydonlar o'zgarmaydi. published → draft — rad.
        || (o.status == 'archived' && n.status == 'draft' && n.published == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'published']))
      );
    }

    // Kalit: o'z rasmiy urinishi topshirilgan (submitted/graded) bo'lsa yoki yechim vaqti kelgan bo'lsa.
    function attKeyReadable(testId, v) {
      let aid = request.auth.uid + '__' + testId;
      return signedIn() && (
        (exists(attAttemptPath(aid))
          && get(attAttemptPath(aid)).data.status in ['submitted', 'graded']
          && attVersionId(get(attAttemptPath(aid)).data.testVersion) == v)
        || (attCanAccess() && attSolutionOpen(attTest(testId)))
      );
    }

    match /attestationPhysicsDailyTests/{testId} {
      allow get: if isAdmin() || (attCanAccess() && attVisible(resource.data));
      // Foydalanuvchi so'rovi: where('published', '==', true) bo'lishi shart (draft hech qachon qaytmaydi)
      allow list: if isAdmin() || (attCanAccess() && resource.data.published == true);
      allow create: if isAdmin() && attValidTestShape(request.resource.data, testId)
        && request.resource.data.status == 'draft' && request.resource.data.published == false
        && request.resource.data.publishedAt == null && request.resource.data.solutionAvailableAt == null;
      allow update: if isAdmin() && attValidTestUpdate(testId);
      allow delete: if false;

      match /versions/{v} {
        allow get: if isAdmin() || (attCanAccess() && attVisible(attTest(testId)));
        allow list: if isAdmin();
        allow create: if isAdmin() && request.resource.data.testId == testId
          && attVersionId(request.resource.data.version) == v;
        allow update: if isAdmin() && attTest(testId).status == 'draft' && attTest(testId).publishedAt == null
          && request.resource.data.testId == testId && attVersionId(request.resource.data.version) == v;
        allow delete: if false;
      }

      match /keys/{v} {
        allow get: if isAdmin() || attKeyReadable(testId, v);
        allow list: if isAdmin();
        allow create: if isAdmin() && request.resource.data.testId == testId
          && attVersionId(request.resource.data.version) == v
          && request.resource.data.answers is map
          && request.resource.data.answers.size() == request.resource.data.scorableCount;
        allow update: if isAdmin() && attTest(testId).status == 'draft' && attTest(testId).publishedAt == null
          && request.resource.data.testId == testId && attVersionId(request.resource.data.version) == v;
        allow delete: if false;
      }

      // Rasmlar (Firestore muqobili, settings.figureBackend == 'firestore'): savol rasmlari published bo'lganda,
      // yechim rasmlari solutionAvailableAt dan keyin. O'zgarmas.
      match /figures/{figId} {
        allow get: if isAdmin() || (attCanAccess() && attVisible(attTest(testId)));
        allow list: if isAdmin();
        allow create: if isAdmin() && request.resource.data.testId == testId && request.resource.data.id == figId;
        allow update, delete: if false;
      }

      match /solutionFigures/{figId} {
        allow get: if isAdmin() || (attCanAccess() && attSolutionOpen(attTest(testId)));
        allow list: if isAdmin();
        allow create: if isAdmin() && request.resource.data.testId == testId && request.resource.data.id == figId;
        allow update, delete: if false;
      }

      match /solutions/{v} {
        allow get: if isAdmin() || (attCanAccess() && attSolutionOpen(attTest(testId)));
        allow list: if isAdmin();
        allow create: if isAdmin() && request.resource.data.testId == testId
          && attVersionId(request.resource.data.version) == v;
        allow update: if isAdmin() && attTest(testId).status == 'draft' && attTest(testId).publishedAt == null
          && request.resource.data.testId == testId && attVersionId(request.resource.data.version) == v;
        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------- attempts
    // START: server vaqti, faqat published (archived emas) va yechim ochilmasdan oldin; 1 ta rasmiy urinish.
    function attValidStart(attemptId) {
      let d = request.resource.data;
      let t = attTest(d.testId);
      return attCanAccess()
        && d.keys().hasOnly(['userId', 'testId', 'dayNumber', 'testVersion', 'attemptNumber', 'kind', 'status',
                             'startedAt', 'questionCount'])
        && d.keys().hasAll(['userId', 'testId', 'dayNumber', 'testVersion', 'attemptNumber', 'kind', 'status',
                            'startedAt', 'questionCount'])
        && d.userId == request.auth.uid
        && d.testId is string && attemptId == request.auth.uid + '__' + d.testId
        && t.published == true && t.status == 'published'
        && request.time < t.solutionAvailableAt
        && d.dayNumber == t.dayNumber
        && d.testVersion == t.currentVersion
        && d.attemptNumber == 1 && d.kind == 'official'
        && d.status == 'in_progress'
        && d.startedAt == request.time
        && d.questionCount == t.questionCount;
    }

    function attKey(o) {
      return get(/databases/$(database)/documents/attestationPhysicsDailyTests/$(o.testId)/keys/$(attVersionId(o.testVersion))).data;
    }

    function attValidAnswers(o, n) {
      return n.answers is map && n.answers.size() <= o.questionCount
        && n.answers.keys().hasOnly(attKey(o).questionIds)
        && n.answers.values().hasOnly(['A', 'B', 'C', 'D', 'E']);
    }

    // SAVE (qoralama): test davomida javoblarni saqlash (boshqa qurilmada davom etish uchun).
    // Kalit bu paytda o'qilmaydi va natija maydonlari taqiqlangan — oracle yo'q.
    function attValidSave() {
      let o = resource.data;
      let n = request.resource.data;
      return signedIn() && o.userId == request.auth.uid
        && o.status == 'in_progress' && n.status == 'in_progress'
        && n.diff(o).affectedKeys().hasOnly(['answers', 'savedAt'])
        && n.savedAt == request.time
        && request.time < attTest(o.testId).solutionAvailableAt
        && attValidAnswers(o, n);
    }

    // SUBMIT: javoblar qulflanadi — map {questionId: 'A'..'E'} (javobsiz savol yozilmaydi), server vaqti,
    // yechim ochilmasdan oldin. VAQT CHEGARASI YO'Q (3-bosqich). Natija maydonlari bu bosqichda TAQIQLANGAN.
    function attValidSubmit() {
      let o = resource.data;
      let n = request.resource.data;
      return signedIn() && o.userId == request.auth.uid
        && o.status == 'in_progress'
        && n.diff(o).affectedKeys().hasOnly(['status', 'completedAt', 'answers', 'savedAt'])
        && n.status == 'submitted'
        && n.completedAt == request.time
        && (!('savedAt' in n.diff(o).affectedKeys()) || n.savedAt == request.time)
        && request.time < attTest(o.testId).solutionAvailableAt
        && attValidAnswers(o, n);
    }

    // GRADE: faqat submit'dan keyin. Kalit (keys/v{N}.answers) — FAQAT auto savollar: {questionId: 'A'..'E'}.
    //   answers.diff(key): unchanged = to'g'ri, changed = noto'g'ri, removed = javobsiz (auto),
    //   added = baholanmaydigan (open/unreliable) savollarga berilgan javob — hisobga olinmaydi.
    // Klient yozgan HAR BIR qiymat shu to'plamlar bilan Rules ichida solishtiriladi.
    function attValidGrade() {
      let o = resource.data;
      let n = request.resource.data;
      let k = attKey(o);
      let d = o.answers.diff(k.answers);
      let s = k.scorableCount;
      let c = n.correctAnswers;
      return signedIn() && (o.userId == request.auth.uid || isAdmin())
        && o.status == 'submitted'
        && n.diff(o).affectedKeys().hasOnly(['status', 'gradedAt', 'timeSpentSeconds', 'totalQuestions',
                                             'scorableQuestions', 'correctAnswers', 'wrongAnswers', 'unanswered',
                                             'scorePercent', 'correctIds', 'wrongIds'])
        && n.status == 'graded'
        && n.gradedAt == request.time
        && n.timeSpentSeconds == (o.completedAt - o.startedAt).seconds()
        && n.totalQuestions == o.questionCount
        && n.scorableQuestions == s && s == k.answers.size()
        && c == d.unchangedKeys().size()
        && n.wrongAnswers == d.changedKeys().size()
        && n.unanswered == d.removedKeys().size()
        && n.correctIds is list && n.correctIds.size() == c && d.unchangedKeys().hasAll(n.correctIds)
        && n.wrongIds is list && n.wrongIds.size() == n.wrongAnswers && d.changedKeys().hasAll(n.wrongIds)
        && n.scorePercent is int
        && ((s == 0 && n.scorePercent == 0)
            || (s > 0 && (n.scorePercent * s - c * 100) * 2 <= s && (n.scorePercent * s - c * 100) * 2 > 0 - s));
    }

    match /attestationPhysicsAttempts/{attemptId} {
      // get: ID egasi bo'yicha (hujjat hali yo'q bo'lsa ham "yo'q" javobi qaytadi, permission xatosi emas)
      allow get: if isAdmin() || (signedIn() && attemptId.split('__')[0] == request.auth.uid);
      allow list: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if attValidStart(attemptId);
      allow update: if attValidSave() || attValidSubmit() || attValidGrade();
      allow delete: if false;
    }
    // <<< attestation-physics
  }
}
