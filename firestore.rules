rules_version = '2';

// ============================================================================
// OliyFizika.uz — Firestore Security Rules (Phase 19 — Admin System 1.0 + security; Phase 19C — XP integrity;
//                                             Admin System 2.0 — bo'limli adminlar + amallar jurnali)
//
// DIQQAT: bu fayl repositoryda saqlanadi, avtomatik DEPLOY QILINMAYDI.
// Production'ga faqat loyiha egasi tekshirib, qo'lda qo'yadi (Firebase Console → Firestore → Rules
// yoki `firebase deploy --only firestore:rules`).
//
// Model:
//   ADMINLAR (Admin System 2.0):
//     • role == 'admin'               — har qanday administrator (eski kod va sahifalar shu maydonga tayanadi).
//     • adminRole == 'owner'          — sayt egasi: hamma bo'lim + adminlarni tayinlash/olib tashlash + amallar jurnali.
//                                       FAQAT Firebase Console'da qo'yiladi (klient hech qachon yozolmaydi).
//     • adminSections: [..]           — oddiy adminga owner biriktirgan bo'limlar (ADMIN_SECTIONS ro'yxatidan).
//                                       Maydon YO'Q bo'lsa — eski (to'liq) admin: barcha bo'limlar (hech narsa buzilmasin).
//                                       Bo'sh ro'yxat [] — hech qaysi bo'lim (faqat Dashboard/Sozlamalar).
//   users/{uid}
//     • egasi o'qiydi; admin hammasini o'qiydi/sanaydi.
//     • egasi yaratadi — faqat standart qiymatlar bilan (xp 0, level 1, fullAccess false, role/mockTestsAccess YO'Q).
//     • egasi yangilaydi — faqat firstName, lastName, fullName, lastActiveAt
//       (+ eski hisoblarda YO'Q maydonlarni standart qiymat bilan to'ldirish — ensureUserProfile);
//       XP: faqat users/{uid}/xpGrants/L{lessonId} grant hujjati bilan BIR atomik yozuvda (Phase 19C):
//       bitta mavzu — bitta grant (deterministik ID, o'zgarmas) — XP bir martadan ortiq berilmaydi.
//     • 'kirish-huquqlari' bo'limi admini — faqat fullAccess, mockTestsAccess, attestationAccess (bool).
//     • owner — role ('user'|'admin') + adminSections (+ adminUpdatedAt/By); o'zini va boshqa owner'ni o'zgartirmaydi.
//     • o'chirish — faqat owner.
//   results/{id}
//     • faqat o'z uid'i bilan yaratiladi; maydonlar/turlar/percent–score–passed mosligi tekshiriladi.
//     • egasi va 'umumiy-fizika' / 'foydalanuvchilar' admini o'qiydi; update — hech kim; delete — 'umumiy-fizika' admini.
//   users/{uid}/xpGrants/L{lessonId}   (Phase 19C — XP audit + idempotentlik)
//     • faqat egasi yaratadi, users.xp/level/lastXpGrant yangilanishi bilan BIRGA (batch/tranzaksiya);
//       natija (results/{resultId}) shu foydalanuvchiniki, shu mavzu, passed va foizi XP'ga mos bo'lishi shart.
//     • egasi va admin o'qiydi; update/delete — hech kim (immutable).
//   mockTestAttempts/{uid}__{attemptId}   (Milliy sertifikat mock urinishlari — admin statistikasi)
//     • egasi yaratadi (o'z uid'i, xulosa maydonlari tekshiriladi); egasi o'z yozuvini, 'milliy-sertifikat' admini
//       hammasini o'qiydi; update — hech kim; delete — 'milliy-sertifikat' admini.
//   msMockSettings / msMockSessions / msMockAttempts / msMockCertificates / msMockProfiles
//     • Milliy sertifikat yopiq (sessiyali) mock testlari va Rasch natijalari — batafsil pastdagi bo'limda.
//   adminAuditLog/{id}   (amallar jurnali)
//     • har qanday admin faqat O'Z nomidan, server vaqti bilan yozadi; o'qish — faqat owner; update/delete — hech kim.
//   presence/{sid}   (mehmonlar «online» belgisi — admin dashboard)
//     • istalgan tashrifchi faqat {at: server vaqti, expireAt} yozadi; list (count) — har qanday admin.
//   users/{uid}/gameSets/{setId}   (interaktiv o'yinlar — foydalanuvchi to'plamlari)
//     • faqat egasi o'qiydi/yozadi/o'chiradi; maydonlar va hajm tekshiriladi.
//   Qolgan barcha yo'llar — yopiq (default deny).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- umumiy
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function authEmail() {
      return request.auth.token.get('email', '');
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // Admin: users/{auth.uid}.role == 'admin' (har qanday administrator). `role` maydonini faqat owner yozadi (pastda).
    function isAdmin() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.get('role', 'user') == 'admin';
    }

    // ---------------------------------------------------------------- bo'limli adminlar (Admin System 2.0)
    // Bo'limlar ro'yxati assets/js/admin/permissions.js dagi ADMIN_SECTIONS bilan AYNAN bir xil bo'lishi shart.
    function adminSectionIds() {
      return ['umumiy-fizika', 'milliy-sertifikat', 'attestatsiya-fizika', 'foydalanuvchilar', 'kirish-huquqlari',
              'simulyatsiyalar', 'olimpiada'];
    }

    function myProfile() {
      return get(userPath(request.auth.uid)).data;
    }

    // Sayt egasi: role == 'admin' va adminRole == 'owner' (adminRole faqat Firebase Console'da qo'yiladi).
    function isSiteOwner() {
      return isAdmin() && myProfile().get('adminRole', '') == 'owner';
    }

    // Bo'limni boshqarish: owner | eski admin (adminSections yo'q — to'liq) | adminSections ichida bo'lim bor.
    function canManage(section) {
      return isAdmin() && (
        myProfile().get('adminRole', '') == 'owner'
        || !('adminSections' in myProfile())
        || (myProfile().adminSections is list && section in myProfile().adminSections)
      );
    }

    // ---------------------------------------------------------------- users
    // js/services/xp-service.js dagi LEVELS jadvali bilan aynan bir xil.
    function levelFor(xp) {
      return xp >= 4000 ? 10
        : xp >= 3000 ? 9
        : xp >= 2300 ? 8
        : xp >= 1700 ? 7
        : xp >= 1200 ? 6
        : xp >= 800 ? 5
        : xp >= 500 ? 4
        : xp >= 250 ? 3
        : xp >= 100 ? 2
        : 1;
    }

    function okName(d, key) {
      return !(key in d) || (d[key] is string && d[key].size() <= 100);
    }

    function okNames(d) {
      return okName(d, 'firstName') && okName(d, 'lastName') && okName(d, 'fullName');
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Yangi profil: ensureUserProfile() yozadigan maydonlar, faqat standart qiymatlar bilan.
    function validNewProfile(d) {
      return d.keys().hasOnly(['fullName', 'firstName', 'lastName', 'email', 'xp', 'level',
                               'fullAccess', 'createdAt', 'lastActiveAt'])
        && okNames(d)
        && (!('email' in d) || d.email == authEmail())
        && (!('xp' in d) || d.xp == 0)
        && (!('level' in d) || d.level == 1)
        && (!('fullAccess' in d) || d.fullAccess == false)
        && (!('createdAt' in d) || d.createdAt == request.time)
        && (!('lastActiveAt' in d) || d.lastActiveAt == request.time);
    }

    // ensureUserProfile() eski hujjatda "bo'sh" deb hisoblaydigan holat: yo'q, null yoki ''.
    function wasBlank(key) {
      return !(key in resource.data) || resource.data[key] == null || resource.data[key] == '';
    }

    // Himoyalangan maydon faqat bo'sh bo'lsa va faqat standart qiymat bilan to'ldirilishi mumkin.
    function backfillOnly(key, value) {
      return !(key in changedKeys()) || (wasBlank(key) && request.resource.data[key] == value);
    }

    // Egasi: ism-familiya, faollik vaqti va (eski hisoblarda) yo'q maydonlarni to'ldirish.
    function ownerProfileUpdate() {
      return changedKeys().hasOnly(['firstName', 'lastName', 'fullName', 'lastActiveAt',
                                    'email', 'xp', 'level', 'fullAccess', 'createdAt'])
        && okNames(request.resource.data)
        && (!('lastActiveAt' in changedKeys()) || request.resource.data.lastActiveAt == request.time)
        && backfillOnly('email', authEmail())
        && backfillOnly('xp', 0)
        && backfillOnly('level', 1)
        && backfillOnly('fullAccess', false)
        && backfillOnly('createdAt', request.time);
    }

    // ---------------------------------------------------------------- XP (Phase 19C)
    // Mukofot identifikatori: users/{uid}/xpGrants/L{lessonId} — mavjud semantika: mavzu uchun XP faqat
    // birinchi muvaffaqiyatli topshirishda beriladi. Grant hujjati o'zgarmas, shuning uchun ikkinchi marta
    // yaratib bo'lmaydi (parallel so'rovlarda ham — ikkinchi commit hujjatni mavjud deb ko'radi va rad etiladi).
    function grantPath(uid, grantId) {
      return /databases/$(database)/documents/users/$(uid)/xpGrants/$(grantId);
    }

    function resultPath(resultId) {
      return /databases/$(database)/documents/results/$(resultId);
    }

    // js/services/xp-service.js calculateXP bilan bir xil: 100% → 20, ≥90% → 15, ≥80% → 10.
    function xpFor(percent) {
      return percent == 100 ? 20 : percent >= 90 ? 15 : percent >= 80 ? 10 : 0;
    }

    // Egasi: XP faqat yangi grant bilan bir atomik yozuvda oshadi (xp = grant.newXp, level = levelFor(xp)).
    function ownerXpAward(userId) {
      return changedKeys().hasOnly(['xp', 'level', 'lastXpGrant'])
        && request.resource.data.lastXpGrant is string
        && request.resource.data.lastXpGrant.matches('L[0-9]{1,3}')
        && !exists(grantPath(userId, request.resource.data.lastXpGrant))
        && existsAfter(grantPath(userId, request.resource.data.lastXpGrant))
        && request.resource.data.xp == getAfter(grantPath(userId, request.resource.data.lastXpGrant)).data.newXp
        && resource.data.get('xp', 0) == getAfter(grantPath(userId, request.resource.data.lastXpGrant)).data.previousXp
        && request.resource.data.level == levelFor(request.resource.data.xp);
    }

    // Grant: o'z natijasiga bog'langan, XP miqdori natija foiziga mos, users bilan birga yoziladi.
    function validGrant(userId, grantId) {
      let g = request.resource.data;
      let result = getAfter(resultPath(g.resultId)).data;
      let userAfter = getAfter(userPath(userId)).data;
      return g.keys().hasOnly(['uid', 'lessonId', 'resultId', 'percent', 'xp', 'previousXp', 'newXp', 'level', 'createdAt'])
        && g.keys().hasAll(['uid', 'lessonId', 'resultId', 'percent', 'xp', 'previousXp', 'newXp', 'level', 'createdAt'])
        && g.uid == userId
        && g.lessonId is int && g.lessonId >= 1 && g.lessonId <= 100
        && grantId == 'L' + string(g.lessonId)
        && g.resultId is string && g.resultId.size() > 0 && g.resultId.size() <= 64
        && result.uid == userId
        && result.lessonId == g.lessonId
        && result.passed == true
        && result.percent == g.percent
        && g.xp == xpFor(g.percent) && g.xp > 0
        && g.previousXp == get(userPath(userId)).data.get('xp', 0)
        && g.newXp == g.previousXp + g.xp
        && g.level == levelFor(g.newXp)
        && userAfter.xp == g.newXp
        && userAfter.level == g.level
        && userAfter.lastXpGrant == grantId
        && g.createdAt == request.time;
    }

    // 'kirish-huquqlari' bo'limi admini (va owner): faqat pullik kontent bayroqlari (bool). role/adminSections — YO'Q.
    function adminAccessUpdate(userId) {
      return canManage('kirish-huquqlari')
        && changedKeys().hasOnly(['fullAccess', 'mockTestsAccess', 'attestationAccess'])
        && (!('fullAccess' in changedKeys()) || request.resource.data.fullAccess is bool)
        && (!('mockTestsAccess' in changedKeys()) || request.resource.data.mockTestsAccess is bool)
        && (!('attestationAccess' in changedKeys()) || request.resource.data.attestationAccess is bool);
    }

    // Owner: admin tayinlash / bo'limlarini o'zgartirish / adminlikdan olish.
    //   • o'zini va boshqa owner'ni o'zgartira olmaydi (adminRole faqat Console'da);
    //   • admin bo'lsa — adminSections ro'yxat (faqat ma'lum bo'limlar, takrorsiz hajm); oddiy foydalanuvchida adminSections yo'q;
    //   • adminUpdatedAt == server vaqti, adminUpdatedBy == owner uid.
    function ownerAdminUpdate(userId) {
      let n = request.resource.data;
      return isSiteOwner()
        && userId != request.auth.uid
        && resource.data.get('adminRole', '') != 'owner'
        && !('adminRole' in n)
        && changedKeys().hasOnly(['role', 'adminSections', 'adminUpdatedAt', 'adminUpdatedBy'])
        && n.get('role', 'user') in ['user', 'admin']
        && (n.get('role', 'user') == 'admin'
              ? (n.get('adminSections', null) is list
                 && n.adminSections.size() <= adminSectionIds().size()
                 && adminSectionIds().hasAll(n.adminSections))
              : !('adminSections' in n))
        && n.adminUpdatedAt == request.time
        && n.adminUpdatedBy == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && validNewProfile(request.resource.data);
      allow update: if (isOwner(userId) && (ownerProfileUpdate() || ownerXpAward(userId)))
                    || adminAccessUpdate(userId)
                    || ownerAdminUpdate(userId);
      allow delete: if isSiteOwner();

      // XP mukofotlari jurnali (immutable): egasi o'qiydi/yaratadi, admin o'qiydi.
      match /xpGrants/{grantId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && validGrant(userId, grantId);
        allow update, delete: if false;
      }

      // Interaktiv o'yinlar: foydalanuvchining o'z savollar to'plamlari (Formulani top, Arqon tortish,
      // Baraban). Faqat egasi o'qiydi/yozadi; hajm cheklangan. Kod: interaktiv-oyinlar/shared/game-sets.js
      match /gameSets/{setId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validGameSet(request.resource.data, setId);
      }
    }

    function validGameSet(d, setId) {
      return d.keys().hasOnly(['id', 'kind', 'title', 'topics', 'items', 'createdAt', 'updatedAt'])
        && d.id == setId
        && setId.matches('[A-Za-z0-9_-]{4,40}')
        && d.kind in ['formula', 'question']
        && d.title is string && d.title.size() <= 80
        && d.topics is list && d.topics.size() <= 6
        && d.items is list && d.items.size() <= 150
        && d.createdAt is number && d.updatedAt is number;
    }

    // ---------------------------------------------------------------- results
    function okString(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }

    // js/services/result-service.js yozadigan sxema. percent = Math.round(score / total * 100)
    // butun sonlarda tekshiriladi: |percent·total − score·100| ≤ total / 2.
    function validResult(d) {
      return d.keys().hasOnly(['uid', 'fullName', 'email', 'phone', 'lessonId', 'lessonTitle', 'course',
                               'score', 'totalQuestions', 'percent', 'passed', 'attempt', 'completedAt'])
        && d.keys().hasAll(['uid', 'lessonId', 'score', 'totalQuestions', 'percent', 'passed', 'completedAt'])
        && d.uid == request.auth.uid
        && d.lessonId is number
        && d.score is int && d.totalQuestions is int && d.percent is int
        && d.totalQuestions > 0 && d.totalQuestions <= 500
        && d.score >= 0 && d.score <= d.totalQuestions
        && d.percent >= 0 && d.percent <= 100
        && (d.percent * d.totalQuestions - d.score * 100) * 2 <= d.totalQuestions
        && (d.percent * d.totalQuestions - d.score * 100) * 2 >= 0 - d.totalQuestions
        && d.passed == (d.percent >= 80)
        && d.completedAt == request.time
        && (!('attempt' in d) || (d.attempt is int && d.attempt >= 1))
        && (!('email' in d) || d.email == authEmail())
        && okString(d, 'fullName', 200)
        && okString(d, 'phone', 40)
        && okString(d, 'lessonTitle', 300)
        && okString(d, 'course', 60);
    }

    match /results/{resultId} {
      allow create: if signedIn() && validResult(request.resource.data);
      allow read: if canManage('umumiy-fizika') || canManage('foydalanuvchilar')
                  || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if false;
      allow delete: if canManage('umumiy-fizika');
    }

    // ---------------------------------------------------------------- mockTestAttempts
    // Milliy sertifikat interaktiv mock testlari — topshirilgan urinish xulosasi (admin statistikasi uchun).
    // Kod: milliy-sertifikat/mock-testlar/js/attempt-record.js. ID: {uid}__{attemptId} (bitta urinish — bitta yozuv).
    // Ball brauzerda hisoblanadi (statistika uchun; rasmiy natija emas). Xom/to'g'ri javoblar yozilmaydi.
    // Egasi yaratadi va o'z yozuvini o'qiydi; ro'yxat — faqat admin; update — hech kim; delete — faqat admin.
    // mockTestsAccess / pullik yechimlar bilan bog'liq emas.
    function okCount(d, key) {
      return d[key] is int && d[key] >= 0 && d[key] <= 1000;
    }

    function validMockAttempt(d, docId) {
      return d.keys().hasOnly(['schemaVersion', 'uid', 'name', 'email', 'testId', 'testNumber', 'testTitle', 'attemptId',
                               'correct', 'maxScore', 'percent', 'full', 'partial', 'blank', 'questionCount',
                               'durationSec', 'autoSubmitted', 'focusLoss', 'startedAtMs', 'finishedAtMs', 'submittedAt'])
        && d.keys().hasAll(['schemaVersion', 'uid', 'testId', 'attemptId', 'correct', 'maxScore', 'percent', 'submittedAt'])
        && d.schemaVersion == 1
        && d.uid == request.auth.uid
        && d.attemptId is string && d.attemptId.matches('[A-Za-z0-9-]{8,64}')
        && docId == d.uid + '__' + d.attemptId
        && d.testId is string && d.testId.matches('mock-test-[0-9]{1,3}')
        && okCount(d, 'correct') && okCount(d, 'maxScore') && d.maxScore > 0 && d.correct <= d.maxScore
        && d.percent is int && d.percent >= 0 && d.percent <= 100
        && (d.percent * d.maxScore - d.correct * 100) * 2 <= d.maxScore
        && (d.percent * d.maxScore - d.correct * 100) * 2 >= 0 - d.maxScore
        && (!('full' in d) || okCount(d, 'full'))
        && (!('partial' in d) || okCount(d, 'partial'))
        && (!('blank' in d) || okCount(d, 'blank'))
        && (!('questionCount' in d) || okCount(d, 'questionCount'))
        && (!('testNumber' in d) || okCount(d, 'testNumber'))
        && (!('focusLoss' in d) || (d.focusLoss is int && d.focusLoss >= 0))
        && (!('durationSec' in d) || (d.durationSec is int && d.durationSec >= 0 && d.durationSec <= 86400))
        && (!('startedAtMs' in d) || d.startedAtMs is int)
        && (!('finishedAtMs' in d) || (d.finishedAtMs is int && d.finishedAtMs <= request.time.toMillis() + 600000))
        && (!('autoSubmitted' in d) || d.autoSubmitted is bool)
        && (!('email' in d) || d.email == authEmail())
        && okString(d, 'name', 200)
        && okString(d, 'testTitle', 200)
        && d.submittedAt == request.time;
    }

    match /mockTestAttempts/{docId} {
      allow create: if signedIn() && validMockAttempt(request.resource.data, docId);
      allow get: if canManage('milliy-sertifikat') || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if canManage('milliy-sertifikat');
      allow update: if false;
      allow delete: if canManage('milliy-sertifikat');
    }

    // ---------------------------------------------------------------- Milliy sertifikat: yopiq (sessiyali) mock testlar + Rasch
    // Kod: milliy-sertifikat/mock-testlar/js/session-service.js (foydalanuvchi), assets/js/admin/ms-sessions.js (admin),
    //      milliy-sertifikat/mock-testlar/js/rasch.js (hisob). Eski mockTestAttempts (mashq natijalari) bilan aloqasi yo'q.
    //   msMockSettings/config            — practiceTests: erkin (mashq) rejimida ochiq mocklar ro'yxati. O'qish — hamma.
    //   msMockSessions/{sessionId}       — admin ochgan sessiya: testId, opensAt..closesAt, durationMinutes, status
    //                                      ('scheduled' → 'finalized'). O'qish — hamma (katalog), yozish — 'milliy-sertifikat' admini.
    //   msMockAttempts/{sessionId}__{uid} — ishtirokchining xom javoblari. Egasi: START faqat oyna ichida (server vaqti),
    //                                      javoblarni faqat in_progress va startedAt + durationMinutes + 5 daqiqa ichida yozadi,
    //                                      submitted ga o'tkazadi. Natija (result) — FAQAT admin yozadi ('published').
    //                                      Egasi o'z urinishini o'qiydi; ro'yxat — admin yoki o'z uid filtri bilan.
    //   msMockCertificates/{certNo}      — e'lon qilingan sertifikat (QR orqali tekshirish): get — hamma, list/yozish — admin.
    //   msMockProfiles/{uid}             — sertifikat uchun rasm (JPEG data URL, ≤ 350 KB) va otasining ismi: egasi + admin.
    function msSession(sid) {
      return get(/databases/$(database)/documents/msMockSessions/$(sid)).data;
    }

    function validMsSession(d) {
      return d.keys().hasOnly(['testId', 'testNumber', 'testTitle', 'opensAt', 'closesAt', 'durationMinutes', 'status',
                               'createdAt', 'createdBy', 'updatedAt', 'note', 'finalizedAt', 'finalizedBy', 'stats'])
        && d.testId is string && d.testId.matches('mock-test-[0-9]{1,3}')
        && d.opensAt is timestamp && d.closesAt is timestamp && d.closesAt > d.opensAt
        && d.durationMinutes is int && d.durationMinutes >= 10 && d.durationMinutes <= 600
        && d.status in ['scheduled', 'finalized']
        && okString(d, 'testTitle', 200)
        && okString(d, 'note', 500)
        && (!('stats' in d) || (d.stats is map && d.stats.size() <= 30));
    }

    match /msMockSettings/{docId} {
      allow read: if true;
      allow write: if canManage('milliy-sertifikat')
        && request.resource.data.keys().hasOnly(['practiceTests', 'updatedAt', 'updatedBy'])
        && request.resource.data.practiceTests is list && request.resource.data.practiceTests.size() <= 200;
    }

    match /msMockSessions/{sessionId} {
      allow read: if true;
      allow create, update: if canManage('milliy-sertifikat') && sessionId.matches('[A-Za-z0-9_-]{3,80}')
        && validMsSession(request.resource.data);
      allow delete: if canManage('milliy-sertifikat');
    }

    function msAnswers(d) {
      return d.answers is map && d.answers.size() <= 80;
    }

    // Javob yozish oynasi: startedAt + durationMinutes + 5 daqiqa (tarmoq kechikishi uchun), sessiya hali yakunlanmagan.
    function msWithinLimit(o, s) {
      return s.status == 'scheduled'
        && request.time <= o.startedAt + duration.value(s.durationMinutes * 60 + 300, 's');
    }

    function validMsStart(d, sid) {
      return d.keys().hasOnly(['uid', 'name', 'email', 'sessionId', 'testId', 'status', 'startedAt', 'updatedAt', 'answers', 'focusLoss'])
        && d.uid == request.auth.uid
        && d.sessionId == sid
        && exists(/databases/$(database)/documents/msMockSessions/$(sid))
        && msSession(sid).status == 'scheduled'
        && d.testId == msSession(sid).testId
        && request.time >= msSession(sid).opensAt
        && request.time < msSession(sid).closesAt
        && d.status == 'in_progress'
        && d.startedAt == request.time
        && (!('updatedAt' in d) || d.updatedAt == request.time)
        && (!('answers' in d) || msAnswers(d))
        && (!('focusLoss' in d) || (d.focusLoss is int && d.focusLoss >= 0))
        && (!('email' in d) || d.email == authEmail())
        && okString(d, 'name', 200);
    }

    // Egasi: in_progress → (javoblar) in_progress | submitted. Natija maydonlariga tegolmaydi.
    function validMsOwnerUpdate(o, n, sid) {
      return o.uid == request.auth.uid
        && o.status == 'in_progress'
        && msWithinLimit(o, msSession(sid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'updatedAt', 'status', 'submittedAt', 'autoSubmitted', 'focusLoss', 'name'])
        && msAnswers(n)
        && n.updatedAt == request.time
        && (n.status == 'in_progress'
            || (n.status == 'submitted' && n.submittedAt == request.time))
        && (!('autoSubmitted' in n) || n.autoSubmitted is bool)
        && (!('focusLoss' in n) || (n.focusLoss is int && n.focusLoss >= 0))
        && okString(n, 'name', 200);
    }

    // Admin: faqat natijani e'lon qiladi (javoblar, vaqtlar va egasi o'zgarmaydi).
    function validMsPublish(o, n) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'result', 'publishedAt'])
        && n.status == 'published'
        && n.result is map && n.result.size() <= 40
        && n.publishedAt == request.time;
    }

    match /msMockAttempts/{attemptId} {
      allow create: if signedIn() && attemptId == request.resource.data.sessionId + '__' + request.auth.uid
        && validMsStart(request.resource.data, request.resource.data.sessionId);
      allow get: if canManage('milliy-sertifikat') || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if canManage('milliy-sertifikat') || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if (signedIn() && validMsOwnerUpdate(resource.data, request.resource.data, resource.data.sessionId))
        || (canManage('milliy-sertifikat') && validMsPublish(resource.data, request.resource.data));
      allow delete: if false;
    }

    match /msMockCertificates/{certNo} {
      allow get: if true;
      allow list: if canManage('milliy-sertifikat');
      allow create, update: if canManage('milliy-sertifikat') && certNo.matches('OF[0-9]{2}-[0-9]{6}')
        && request.resource.data.certNo == certNo
        && request.resource.data.keys().hasOnly(['certNo', 'uid', 'sessionId', 'testId', 'testNumber', 'testTitle', 'lastName',
                                                 'firstName', 'fullName', 'score', 'level', 'percent', 'sections', 'issuedAt'])
        && request.resource.data.score is number;
      allow delete: if canManage('milliy-sertifikat');
    }

    match /msMockProfiles/{uid} {
      allow get: if isOwner(uid) || canManage('milliy-sertifikat');
      allow list: if false;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['photo', 'patronymic', 'updatedAt'])
        && (!('photo' in request.resource.data)
            || (request.resource.data.photo is string && request.resource.data.photo.size() <= 360000
                && request.resource.data.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')))
        && okString(request.resource.data, 'patronymic', 60)
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);
    }

    // ---------------------------------------------------------------- adminAuditLog (amallar jurnali)
    // Kod: assets/js/admin/audit-log.js. Har qanday admin faqat o'z nomidan (actorUid) va server vaqti bilan yozadi.
    // O'qish — faqat owner. O'zgartirish/o'chirish — hech kim (jurnal o'zgarmas).
    function validAudit(d) {
      return d.keys().hasOnly(['actorUid', 'actorEmail', 'actorName', 'action', 'section', 'targetUid', 'targetLabel',
                               'summary', 'details', 'at'])
        && d.keys().hasAll(['actorUid', 'action', 'section', 'summary', 'at'])
        && d.actorUid == request.auth.uid
        && d.at == request.time
        && d.action is string && d.action.matches('[a-z][a-z0-9._-]{1,60}')
        && (d.section in adminSectionIds() || d.section in ['adminlar', 'umumiy'])
        && okString(d, 'summary', 500)
        && (!('actorEmail' in d) || d.actorEmail == authEmail())
        && okString(d, 'actorName', 200)
        && okString(d, 'targetUid', 128)
        && okString(d, 'targetLabel', 300)
        && (!('details' in d) || (d.details is map && d.details.size() <= 20));
    }

    match /adminAuditLog/{logId} {
      allow create: if isAdmin() && validAudit(request.resource.data);
      allow read: if isSiteOwner();
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------- presence (mehmonlar «online» belgisi)
    // Kod: assets/js/core/presence.js (yozadi), assets/js/admin/dashboard.js (sanaydi).
    // Tizimga kirmagan tashrifchi sahifa ko'rinib turganda ~5 daqiqada bir marta o'z hujjatini yangilaydi.
    // Shaxsiy ma'lumot yo'q: faqat at (server vaqti) va expireAt (TTL). Hujjat ID — tasodifiy, brauzerga bog'liq.
    // O'qish (count/list) — faqat admin; get/delete — hech kim (eski hujjatlarni TTL siyosati o'chiradi).
    function validPresence(d, sid) {
      return sid.matches('g_[A-Za-z0-9]{20,40}')
        && d.keys().hasOnly(['at', 'expireAt'])
        && d.at == request.time
        && d.expireAt is timestamp
        && d.expireAt > request.time
        && d.expireAt < request.time + duration.value(2, 'h');
    }

    match /presence/{sid} {
      allow create, update: if validPresence(request.resource.data, sid);
      allow list: if isAdmin();
      allow get, delete: if false;
    }

    // >>> attestation-physics (generated — tools/attestatsiya-fizika/rules/build_rules.py)

    // ============================================================================
    // ATTESTATSIYA → FIZIKA (Attestatsiya 2-bosqich) — FAQAT yangi kolleksiyalar.
    // Yuqoridagi users / xpGrants / results qoidalari O'ZGARTIRILMAGAN. Pedagogika Firestore ishlatmaydi.
    // Admin amallari: attAdmin() = canManage('attestatsiya-fizika') — faqat shu bo'lim biriktirilgan admin (yoki owner).
    // Generator: tools/attestatsiya-fizika/rules/build_rules.py  ·  Hujjat: docs/attestatsiya-fizika/08_security_report.md
    //
    //   attestationPhysicsSettings/config                      accessMode open|paid, timezone, limitlar
    //   attestationPhysicsQuestions/{qid}                      public savol (javobsiz) — faqat published kun
    //   attestationPhysicsQuestions/{qid}/private/answer       javob + yechim — FAQAT admin
    //   attestationPhysicsDailyTests/{testId}                  Day meta; draft — faqat admin
    //     /versions/v{N}   public snapshot (javobsiz)          — published bo'lsa
    //     /keys/v{N}       javob kaliti (ro'yxat)              — o'z urinishini TOPSHIRGANDAN keyin (kunlik va mock)
    //     /solutions/v{N}  to'liq yechimlar                    — o'z urinishi yakunlangan (kunlik va mock)
    //   attestationPhysicsAttempts/{uid}__{testId}             1 ta rasmiy urinish: start → submit → grade
    //
    // Baholash ishonchli: klient yozgan correctAnswers/wrongAnswers/unanswered/scorePercent/correctIds qiymatlari
    // Rules ichida kalit (keys/v{N}) bilan map.diff() orqali solishtiriladi — noto'g'ri qiymat rad etiladi. Javoblar grade'dan
    // OLDIN (submit) qulflanadi, kalit faqat submit'dan keyin o'qiladi — oracle hujumi yo'q.
    // Hech narsa o'chirilmaydi: barcha delete — false.
    // ============================================================================

    // Bo'limli adminlar: Attestatsiya — Fizika bo'limi biriktirilgan admin (owner va eski to'liq adminlar ham).
    function attAdmin() {
      return canManage('attestatsiya-fizika');
    }

    function attSettingsPath() {
      return /databases/$(database)/documents/attestationPhysicsSettings/config;
    }

    function attTestPath(testId) {
      return /databases/$(database)/documents/attestationPhysicsDailyTests/$(testId);
    }

    function attTest(testId) {
      return get(attTestPath(testId)).data;
    }

    function attAttemptPath(attemptId) {
      return /databases/$(database)/documents/attestationPhysicsAttempts/$(attemptId);
    }

    // OPEN: har bir autentifikatsiyadan o'tgan foydalanuvchi. PAID: admin yoki users/{uid}.attestationAccess == true
    // (attestationAccess ni foydalanuvchi o'zi yoza olmaydi — users qoidalaridagi hasOnly ro'yxatlarida yo'q).
    function attCanAccess() {
      return signedIn() && (
        attAdmin()
        || get(attSettingsPath()).data.get('accessMode', 'closed') == 'open'
        || get(userPath(request.auth.uid)).data.get('attestationAccess', false) == true
      );
    }

    // KUN BO'YICHA KIRISH (umumiy qoida, kun raqami hard-code qilinmagan):
    //   dayNumber <= 3            — har bir kirgan foydalanuvchiga ochiq (bepul kunlar);
    //   dayNumber >= 4            — attCanAccess() (admin | accessMode 'open' | attestationAccess == true).
    // accessMode 'open' bo'lsa hammasi ochiq (avvalgidek); 'paid' ga o'tkazilganda 4+ kunlar ruxsat talab qiladi.
    function attFreeDay(t) {
      return t.dayNumber is int && t.dayNumber <= 3;
    }

    // MOCK TEST (kind == 'mock', dayNumber 101+): kurs kunlaridan alohida; paidOnly bo'lmasa — hamma kirgan foydalanuvchi uchun bepul.
    function attIsMock(t) {
      return t.get('kind', 'daily') == 'mock';
    }

    // PULLIK MOCK: test hujjatida paidOnly == true bo'lgan mock — faqat admin yoki users/{uid}.attestationAccess == true
    // (accessMode 'open' bo'lsa ham ochilmaydi: pullik guruh uchun alohida). paidOnly yo'q mock — hamma uchun bepul (avvalgidek).
    function attPaidOnlyMock(t) {
      return attIsMock(t) && t.get('paidOnly', false) == true;
    }

    function attPaidAccess() {
      return signedIn() && (attAdmin() || get(userPath(request.auth.uid)).data.get('attestationAccess', false) == true);
    }

    function attDayOpen(t) {
      return signedIn() && (attPaidOnlyMock(t) ? attPaidAccess() : (attFreeDay(t) || attIsMock(t) || attCanAccess()));
    }

    // Tarix: shu testda o'z rasmiy urinishi bor foydalanuvchi o'z natijasi/ko'rib chiqishi uchun kontentni o'qishda
    // davom etadi (ruxsat keyin olinsa ham). Yangi urinish boshlashga bu yetmaydi (attValidStart — attDayOpen).
    function attHasOwnAttempt(testId) {
      return signedIn() && exists(attAttemptPath(request.auth.uid + '__' + testId));
    }

    function attContentAccess(testId, t) {
      return attDayOpen(t) || attHasOwnAttempt(testId);
    }

    // published va archived — foydalanuvchiga ko'rinadi; draft — yo'q.
    function attVisible(t) {
      return t.published == true && t.status in ['published', 'archived'];
    }

    function attVersionId(n) {
      return 'v' + string(n);
    }

    // ---------------------------------------------------------------- settings
    function attValidSettings(d) {
      return d.keys().hasAll(['accessMode', 'timezone', 'totalDays'])
        && d.accessMode in ['open', 'paid']
        && d.timezone == 'Asia/Tashkent'
        && d.totalDays is int && d.totalDays >= 1 && d.totalDays <= 100
        && (!('figureBackend' in d) || d.figureBackend in ['storage', 'firestore'])
        && !('courseStartDate' in d);
    }

    match /attestationPhysicsSettings/{docId} {
      allow read: if signedIn();
      allow create, update: if attAdmin() && docId == 'config' && attValidSettings(request.resource.data);
      allow delete: if false;
    }

    // ---------------------------------------------------------------- question bank
    // Public hujjatda javob/yechim maydonlari bo'lishi taqiqlangan (admin xatosidan ham himoya).
    function attNoSecrets(d) {
      return !('correctAnswer' in d) && !('solution' in d) && !('answers' in d)
        && !('bookAnswer' in d) && !('solutionResult' in d) && !('review' in d);
    }

    match /attestationPhysicsQuestions/{qid} {
      allow get: if attAdmin() || (attVisible(attTest(resource.data.testId))
        && attContentAccess(resource.data.testId, attTest(resource.data.testId)));
      allow list: if attAdmin();
      allow create, update: if attAdmin() && request.resource.data.id == qid && attNoSecrets(request.resource.data);
      allow delete: if false;

      match /private/{docId} {
        allow read: if attAdmin();
        allow create, update: if attAdmin() && docId == 'answer' && request.resource.data.id == qid;
        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------- daily tests
    function attValidTestShape(d, testId) {
      return d.id == testId
        && d.dayNumber is int && d.dayNumber >= 1 && d.dayNumber <= 199
        // kind: kurs kuni (1..100) yoki mock test (101..199) — ikkalasi bir-biriga aralashmaydi
        && d.get('kind', 'daily') in ['daily', 'mock']
        && ((d.get('kind', 'daily') == 'mock') == (d.dayNumber >= 101))
        && d.questionIds is list && d.questionCount == d.questionIds.size()
        && d.questionCount >= 1 && d.questionCount <= 50
        // 3-bosqich: vaqt chegarasi yo'q — timeLimitSeconds null (maydon kelajak uchun saqlanadi)
        && (d.timeLimitSeconds == null || (d.timeLimitSeconds is int && d.timeLimitSeconds >= 60))
        && d.currentVersion is int && d.currentVersion >= 1
        && d.status in ['draft', 'published', 'archived']
        && d.published is bool;
    }

    function attContentUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['id', 'dayNumber', 'section', 'kind', 'questionIds', 'questionCount', 'publishedAt', 'publishedBy']);
    }

    function attVersionReady(testId, n) {
      return exists(/databases/$(database)/documents/attestationPhysicsDailyTests/$(testId)/versions/$(attVersionId(n)))
        && exists(/databases/$(database)/documents/attestationPhysicsDailyTests/$(testId)/keys/$(attVersionId(n)))
        && exists(/databases/$(database)/documents/attestationPhysicsDailyTests/$(testId)/solutions/$(attVersionId(n)));
    }

    function attValidTestUpdate(testId) {
      let o = resource.data;
      let n = request.resource.data;
      return attValidTestShape(n, testId) && (
        // draft tahriri (publish emas)
        (o.status == 'draft' && n.status == 'draft' && n.published == false
          && n.publishedAt == null && n.solutionAvailableAt == null)
        // PUBLISH (admin push): faqat to'liq tayyor versiya bilan
        || (o.status == 'draft' && n.status == 'published' && n.published == true
          && n.publishedAt == request.time && n.publishedBy == request.auth.uid
          && n.solutionAvailableAt is timestamp && n.solutionAvailableAt > request.time
          && n.questionIds == o.questionIds && n.currentVersion == o.currentVersion
          && attVersionReady(testId, n.currentVersion))
        // published: kontent qulflangan; vaqt limiti, yechim vaqti, xabar va YANGI versiya (+1) mumkin
        || (o.status == 'published' && n.status == 'published' && n.published == true && attContentUnchanged()
          && n.solutionAvailableAt is timestamp
          && (n.currentVersion == o.currentVersion
              || (n.currentVersion == o.currentVersion + 1 && attVersionReady(testId, n.currentVersion))))
        // ARCHIVE: yashiriladi, o'chirilmaydi
        || (o.status == 'published' && n.status == 'archived' && n.published == true && attContentUnchanged()
          && n.archivedAt == request.time && n.currentVersion == o.currentVersion
          && n.solutionAvailableAt == o.solutionAvailableAt)
        // UNARCHIVE (admin): archived → draft. Faqat status va published o'zgaradi; versiya, savollar,
        // publishedAt, solutionAvailableAt va boshqa barcha maydonlar o'zgarmaydi. published → draft — rad.
        || (o.status == 'archived' && n.status == 'draft' && n.published == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'published']))
      );
    }

    // O'z urinishi YAKUNLANGAN (submitted/graded — qo'lda yoki avto-yakunlash): kalit va yechimlar yechim vaqtini kutmaydi.
    function attOwnFinished(testId) {
      let aid = request.auth.uid + '__' + testId;
      return signedIn() && exists(attAttemptPath(aid))
        && get(attAttemptPath(aid)).data.status in ['submitted', 'graded'];
    }

    // ... va aynan shu versiya bo'yicha (keys/v{N}, solutions/v{N}): boshqa versiya hujjati ochilmaydi.
    function attOwnFinishedVersion(testId, v) {
      let aid = request.auth.uid + '__' + testId;
      return attOwnFinished(testId) && attVersionId(get(attAttemptPath(aid)).data.testVersion) == v;
    }

    // Kalit: faqat o'z rasmiy urinishi topshirilgan (submitted/graded) bo'lsa.
    // Kunlik va MOCK testlarda kalit/yechim yechim vaqti bo'yicha OCHILMAYDI (faqat o'z urinishi yakunlangach).
    function attKeyReadable(testId, v) {
      return signedIn() && attOwnFinishedVersion(testId, v);
    }

    // To'liq yechim (solutions/v{N}): o'z urinishi yakunlangan (shu versiya) — kunlik va mock uchun bir xil.
    function attSolutionReadable(testId, v) {
      return attVisible(attTest(testId)) && attOwnFinishedVersion(testId, v);
    }

    match /attestationPhysicsDailyTests/{testId} {
      // Meta (kun, bo'lim, mavzular, savollar soni, sanalar — javob/kontent yo'q): e'lon qilingan kun har bir kirgan
      // foydalanuvchiga ko'rinadi (yopiq 4+ kunlar ham to'liq karta sifatida). Kontent va start — attDayOpen.
      allow get: if attAdmin() || (signedIn() && attVisible(resource.data));
      // Foydalanuvchi so'rovi: where('published', '==', true) bo'lishi shart (draft hech qachon qaytmaydi)
      allow list: if attAdmin() || (signedIn() && resource.data.published == true);
      allow create: if attAdmin() && attValidTestShape(request.resource.data, testId)
        && request.resource.data.status == 'draft' && request.resource.data.published == false
        && request.resource.data.publishedAt == null && request.resource.data.solutionAvailableAt == null;
      allow update: if attAdmin() && attValidTestUpdate(testId);
      allow delete: if false;

      match /versions/{v} {
        allow get: if attAdmin() || (attVisible(attTest(testId)) && attContentAccess(testId, attTest(testId)));
        allow list: if attAdmin();
        allow create: if attAdmin() && request.resource.data.testId == testId
          && attVersionId(request.resource.data.version) == v;
        allow update: if attAdmin() && attTest(testId).status == 'draft' && attTest(testId).publishedAt == null
          && request.resource.data.testId == testId && attVersionId(request.resource.data.version) == v;
        allow delete: if false;
      }

      match /keys/{v} {
        allow get: if attAdmin() || attKeyReadable(testId, v);
        allow list: if attAdmin();
        allow create: if attAdmin() && request.resource.data.testId == testId
          && attVersionId(request.resource.data.version) == v
          && request.resource.data.answers is map
          && request.resource.data.answers.size() == request.resource.data.scorableCount;
        allow update: if attAdmin() && attTest(testId).status == 'draft' && attTest(testId).publishedAt == null
          && request.resource.data.testId == testId && attVersionId(request.resource.data.version) == v;
        allow delete: if false;
      }

      // Rasmlar (Firestore muqobili, settings.figureBackend == 'firestore'): savol rasmlari published bo'lganda,
      // yechim rasmlari — o'z urinishi yakunlangach (kunlik va mock). O'zgarmas.
      match /figures/{figId} {
        allow get: if attAdmin() || (attVisible(attTest(testId)) && attContentAccess(testId, attTest(testId)));
        allow list: if attAdmin();
        allow create: if attAdmin() && request.resource.data.testId == testId && request.resource.data.id == figId;
        allow update, delete: if false;
      }

      match /solutionFigures/{figId} {
        allow get: if attAdmin() || (attVisible(attTest(testId))
          && attOwnFinished(testId));
        allow list: if attAdmin();
        allow create: if attAdmin() && request.resource.data.testId == testId && request.resource.data.id == figId;
        allow update, delete: if false;
      }

      match /solutions/{v} {
        allow get: if attAdmin() || attSolutionReadable(testId, v);
        allow list: if attAdmin();
        allow create: if attAdmin() && request.resource.data.testId == testId
          && attVersionId(request.resource.data.version) == v;
        allow update: if attAdmin() && attTest(testId).status == 'draft' && attTest(testId).publishedAt == null
          && request.resource.data.testId == testId && attVersionId(request.resource.data.version) == v;
        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------- attempts
    // VAQT CHEGARASI (hisob SERVER vaqtida: startedAt + limit).
    //   • KUNLIK va MOCK testlar: har bir foydalanuvchi testni ISTALGAN kunda, BIR marta boshlaydi (yechim vaqti bilan
    //     yopilmaydi); start'dan keyin 2 SOAT (7200 s; test hujjatida timeLimitSeconds bo'lsa — shu qiymat). Yechimlar faqat
    //     o'z urinishi yakunlangach (qo'lda topshirish yoki vaqt tugab avto-yakunlash) ochiladi — attOwnFinished.
    //     (Mock ham kunlik test kabi: yechim vaqti bilan yopilmaydi va yechimlar vaqt bo'yicha ochilmaydi.)
    //   • qo'lda saqlash/topshirish: tugashdan keyin 60 s «grace» (tarmoq kechikishi) ichida ruxsat;
    //   • avtomatik yakunlash: tugash + 60 s dan keyin (klientning o'z topshirishi bilan poygalashmaydi),
    //     completedAt = startedAt + limit (sarflangan vaqt limitdan oshmaydi).
    function attHasLimit(t) {
      return t.get('timeLimitSeconds', null) is int && t.get('timeLimitSeconds', 0) >= 60;
    }

    // Hujjatda maydon bo'lmasa — 2 soat; bo'lsa (mock: 7200) — shu qiymat.
    function attLimitSec(t) {
      return attHasLimit(t) ? t.get('timeLimitSeconds', 7200) : 7200;
    }

    function attLimitEnd(o, t) {
      return o.startedAt + duration.value(attLimitSec(t), 's');
    }

    // Chegara amal qiladimi: kunlik va mock — doim (startedAt + limit).
    function attLimited(o, t) {
      return o.startedAt is timestamp;
    }

    function attEndAt(o, t) {
      return attLimited(o, t) ? attLimitEnd(o, t) : t.solutionAvailableAt;
    }

    function attAutoFrom(o, t) {
      return attLimited(o, t) ? attLimitEnd(o, t) + duration.value(60, 's') : t.solutionAvailableAt;
    }

    function attInTime(o, t) {
      return attLimited(o, t)
        ? request.time < attLimitEnd(o, t) + duration.value(60, 's')
        : request.time < t.solutionAvailableAt;
    }

    // START: server vaqti, faqat published (archived emas); kunlik va mock — istalgan kunda; 1 ta rasmiy urinish.
    function attValidStart(attemptId) {
      let d = request.resource.data;
      let t = attTest(d.testId);
      return attDayOpen(t)
        && d.keys().hasOnly(['userId', 'testId', 'dayNumber', 'testVersion', 'attemptNumber', 'kind', 'status',
                             'startedAt', 'questionCount'])
        && d.keys().hasAll(['userId', 'testId', 'dayNumber', 'testVersion', 'attemptNumber', 'kind', 'status',
                            'startedAt', 'questionCount'])
        && d.userId == request.auth.uid
        && d.testId is string && attemptId == request.auth.uid + '__' + d.testId
        && t.published == true && t.status == 'published'
        && d.dayNumber == t.dayNumber
        && d.testVersion == t.currentVersion
        && d.attemptNumber == 1 && d.kind == 'official'
        && d.status == 'in_progress'
        && d.startedAt == request.time
        && d.questionCount == t.questionCount;
    }

    function attKey(o) {
      return get(/databases/$(database)/documents/attestationPhysicsDailyTests/$(o.testId)/keys/$(attVersionId(o.testVersion))).data;
    }

    function attValidAnswers(o, n) {
      return n.answers is map && n.answers.size() <= o.questionCount
        && n.answers.keys().hasOnly(attKey(o).questionIds)
        && n.answers.values().hasOnly(['A', 'B', 'C', 'D', 'E']);
    }

    // SAVE (qoralama): test davomida javoblarni saqlash (boshqa qurilmada davom etish uchun).
    // Kalit bu paytda o'qilmaydi va natija maydonlari taqiqlangan — oracle yo'q.
    function attValidSave() {
      let o = resource.data;
      let n = request.resource.data;
      return signedIn() && o.userId == request.auth.uid
        && o.status == 'in_progress' && n.status == 'in_progress'
        && n.diff(o).affectedKeys().hasOnly(['answers', 'savedAt'])
        && n.savedAt == request.time
        && attInTime(o, attTest(o.testId))
        && attValidAnswers(o, n);
    }

    // SUBMIT: javoblar qulflanadi — map {questionId: 'A'..'E'} (javobsiz savol yozilmaydi), server vaqti,
    // yechim ochilmasdan oldin. VAQT CHEGARASI YO'Q (3-bosqich). Natija maydonlari bu bosqichda TAQIQLANGAN.
    function attValidSubmit() {
      let o = resource.data;
      let n = request.resource.data;
      return signedIn() && o.userId == request.auth.uid
        && o.status == 'in_progress'
        && n.diff(o).affectedKeys().hasOnly(['status', 'completedAt', 'answers', 'savedAt'])
        && n.status == 'submitted'
        && n.completedAt == request.time
        && (!('savedAt' in n.diff(o).affectedKeys()) || n.savedAt == request.time)
        && attInTime(o, attTest(o.testId))
        && attValidAnswers(o, n);
    }

    // AUTO-FINALIZE (lazy): yechim ochilgan vaqtda (request.time >= solutionAvailableAt — yechimlar bilan BIR XIL chegara)
    // hali in_progress bo'lgan rasmiy urinish «submitted» ga o'tkaziladi. Egasi (qaytib kirganda) yoki admin bajaradi.
    // Javoblar O'ZGARMAYDI (oxirgi saqlangan qoralama; yo'q bo'lsa — bo'sh map), completedAt = solutionAvailableAt
    // (sarflangan vaqt shu chegara bilan cheklanadi). Natija maydonlari bu yerda taqiqlangan — baholash mavjud GRADE orqali.
    // Qo'lda SUBMIT esa faqat request.time < solutionAvailableAt: ikki yo'l server vaqti bo'yicha kesishmaydi.
    function attValidAutoSubmit() {
      let o = resource.data;
      let n = request.resource.data;
      let t = attTest(o.testId);
      return signedIn() && (o.userId == request.auth.uid || attAdmin())
        && o.status == 'in_progress' && o.kind == 'official' && o.testVersion is int
        && t.solutionAvailableAt is timestamp && request.time >= attAutoFrom(o, t)
        && n.diff(o).affectedKeys().hasOnly(['status', 'completedAt', 'answers', 'autoFinalized'])
        && n.status == 'submitted'
        && n.completedAt == attEndAt(o, t)
        && n.autoFinalized == true
        && (('answers' in o && n.answers == o.answers)
            || (!('answers' in o) && n.answers is map && n.answers.size() == 0));
    }

    // GRADE: faqat submit'dan keyin. Kalit (keys/v{N}.answers) — FAQAT auto savollar: {questionId: 'A'..'E'}.
    //   answers.diff(key): unchanged = to'g'ri, changed = noto'g'ri, removed = javobsiz (auto),
    //   added = baholanmaydigan (open/unreliable) savollarga berilgan javob — hisobga olinmaydi.
    // Klient yozgan HAR BIR qiymat shu to'plamlar bilan Rules ichida solishtiriladi.
    function attValidGrade() {
      let o = resource.data;
      let n = request.resource.data;
      let k = attKey(o);
      let d = o.answers.diff(k.answers);
      let s = k.scorableCount;
      let c = n.correctAnswers;
      return signedIn() && (o.userId == request.auth.uid || attAdmin())
        && o.status == 'submitted'
        && n.diff(o).affectedKeys().hasOnly(['status', 'gradedAt', 'timeSpentSeconds', 'totalQuestions',
                                             'scorableQuestions', 'correctAnswers', 'wrongAnswers', 'unanswered',
                                             'scorePercent', 'correctIds', 'wrongIds'])
        && n.status == 'graded'
        && n.gradedAt == request.time
        && n.timeSpentSeconds == (o.completedAt - o.startedAt).seconds()
        && n.totalQuestions == o.questionCount
        && n.scorableQuestions == s && s == k.answers.size()
        && c == d.unchangedKeys().size()
        && n.wrongAnswers == d.changedKeys().size()
        && n.unanswered == d.removedKeys().size()
        && n.correctIds is list && n.correctIds.size() == c && d.unchangedKeys().hasAll(n.correctIds)
        && n.wrongIds is list && n.wrongIds.size() == n.wrongAnswers && d.changedKeys().hasAll(n.wrongIds)
        && n.scorePercent is int
        && ((s == 0 && n.scorePercent == 0)
            || (s > 0 && (n.scorePercent * s - c * 100) * 2 <= s && (n.scorePercent * s - c * 100) * 2 > 0 - s));
    }

    match /attestationPhysicsAttempts/{attemptId} {
      // get: ID egasi bo'yicha (hujjat hali yo'q bo'lsa ham "yo'q" javobi qaytadi, permission xatosi emas)
      allow get: if attAdmin() || (signedIn() && attemptId.split('__')[0] == request.auth.uid);
      allow list: if attAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if attValidStart(attemptId);
      allow update: if attValidSave() || attValidSubmit() || attValidAutoSubmit() || attValidGrade();
      allow delete: if false;
    }
    // <<< attestation-physics
  }
}
