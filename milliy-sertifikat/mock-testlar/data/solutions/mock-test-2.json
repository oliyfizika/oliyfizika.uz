 "items": {
  "1": [
   {
    "t": "p",
    "text": "Grafik koordinataning vaqtga bog‘lanishini ko‘rsatadi. 2–3 s oralig‘ida $x$ 40 m dan 20 m gacha kamayadi, 3–5 s oralig‘ida $x=20$ m o‘zgarmaydi (jism tinch turadi)."
   },
   {
    "t": "math",
    "tex": "s=|20-40|+0=20\\ \\text{m}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**A)** 20 m"
     }
    ]
   }
  ],
  "2": [
   {
    "t": "given",
    "blocks": [
     {
      "t": "p",
      "text": "$v_0=20$ m/s, $v=60$ m/s, tekis tezlanuvchan harakat"
     }
    ]
   },
   {
    "t": "p",
    "text": "Yo‘lning birinchi va ikkinchi yarmi uchun $v^2-v_0^2=2as$ formulasini yozamiz:"
   },
   {
    "t": "math",
    "tex": "v_1^2-v_0^2=2a\\frac{s}{2},\\quad v^2-v_1^2=2a\\frac{s}{2}\\;\\Rightarrow\\;v_1=\\sqrt{\\frac{v_0^2+v^2}{2}}"
   },
   {
    "t": "math",
    "tex": "v_1=\\sqrt{\\frac{400+3600}{2}}=\\sqrt{2000}=20\\sqrt5\\approx20\\cdot2{,}2=44\\ \\text{m/s}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**B)** 44 m/s"
     }
    ]
   }
  ],
  "3": [
   {
    "t": "given",
    "blocks": [
     {
      "t": "p",
      "text": "$m=6{,}5$ kg, $F_1=12$ N, $F_2=5$ N, kuchlar orasidagi burchak $90^\\circ$"
     }
    ]
   },
   {
    "t": "math",
    "tex": "F=\\sqrt{F_1^2+F_2^2}=\\sqrt{144+25}=13\\ \\text{N},\\qquad a=\\frac{F}{m}=\\frac{13}{6{,}5}=2\\ \\text{m/s}^2"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**A)** 2 m/s²"
     }
    ]
   }
  ],
  "4": [
   {
    "t": "given",
    "blocks": [
     {
      "t": "p",
      "text": "$t=4$ s da $h=40$ m (ikkinchi marta, ya’ni pastga tushayotganda), $g=10$ m/s²"
     }
    ]
   },
   {
    "t": "math",
    "tex": "h=v_0t-\\frac{gt^2}{2}\\;\\Rightarrow\\;40=4v_0-80\\;\\Rightarrow\\;v_0=30\\ \\text{m/s}"
   },
   {
    "t": "p",
    "text": "Tekshiruv: ko‘tarilish vaqti 3 s, demak $t=4$ s da jism haqiqatan pastga tushmoqda."
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**B)** 30 m/s"
     }
    ]
   }
  ],
  "5": [
   {
    "t": "given",
    "blocks": [
     {
      "t": "p",
      "text": "$m_1=3$ kg, $m_2=6$ kg, $m_3=1$ kg, $F=120$ N, $\\mu=0{,}5$"
     }
    ]
   },
   {
    "t": "p",
    "text": "Butun sistema uchun:"
   },
   {
    "t": "math",
    "tex": "a=\\frac{F-\\mu(m_1+m_2+m_3)g}{m_1+m_2+m_3}=\\frac{120-50}{10}=7\\ \\text{m/s}^2"
   },
   {
    "t": "p",
    "text": "$T_1$ ip $m_2$ va $m_3$ ni, $T_2$ ip faqat $m_3$ ni tortadi:"
   },
   {
    "t": "math",
    "tex": "T_1=(m_2+m_3)(a+\\mu g)=7\\cdot12=84\\ \\text{N},\\qquad T_2=m_3(a+\\mu g)=1\\cdot12=12\\ \\text{N}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**B)** 84 N; 12 N"
     }
    ]
   }
  ],
