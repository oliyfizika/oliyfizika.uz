  "26": [
   {
    "t": "given",
    "blocks": [
     {
      "t": "p",
      "text": "$h_s=24$ cm, $\\sigma_s=0{,}073$ N/m, $\\sigma_b=0{,}021$ N/m, $\\rho_s=1000$ kg/m³, $\\rho_b=700$ kg/m³"
     }
    ]
   },
   {
    "t": "p",
    "text": "Naylar bir xil, ikkala suyuqlik ham shishani to‘liq ho‘llaydi: $h=\\dfrac{2\\sigma}{\\rho g r}$."
   },
   {
    "t": "math",
    "tex": "\\frac{h_b}{h_s}=\\frac{\\sigma_b}{\\sigma_s}\\cdot\\frac{\\rho_s}{\\rho_b}=\\frac{0{,}021}{0{,}073}\\cdot\\frac{1000}{700}\\approx0{,}411"
   },
