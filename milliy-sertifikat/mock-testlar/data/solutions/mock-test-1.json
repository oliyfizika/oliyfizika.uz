    ]
   },
   {
    "t": "math",
    "tex": "\\gamma=\\frac{1}{\\sqrt{1-0{,}36}}=\\frac{1}{0{,}8}=1{,}25,\\qquad E=\\gamma E_0=1{,}25\\cdot1{,}2=1{,}5\\ \\text{TJ}"
   },
   {
    "t": "answer",
