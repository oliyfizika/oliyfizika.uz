  "2": [
   {
    "t": "p",
    "text": "Quvvat — kinetik energiyaning o‘zgarish tezligi: $N=\\frac{dE_k}{dt}=2\\alpha t$. Bundan ($v_0=0$):"
   },
   {
    "t": "math",
    "tex": "E_k=\\alpha t^2=\\frac{mv^2}{2}\\;\\Rightarrow\\;v=\\sqrt{\\frac{2\\alpha}{m}}\\,t"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**D)** √(2α/m)·t"
     }
    ]
   }
  ],
  "3": [
   {
    "t": "p",
    "text": "Quyonning burgutga nisbatan tezligi $\\vec v_{\\text{nis}}=\\vec v_q-\\vec v_b$, demak $\\vec v_b=\\vec v_q-\\vec v_{\\text{nis}}$. Quyon tezligi janubga 3,9 m/s, nisbiy tezlik sharqqa 5,2 m/s, ular o‘zaro tik:"
   },
   {
    "t": "math",
    "tex": "v_b=\\sqrt{3{,}9^2+5{,}2^2}=\\sqrt{15{,}21+27{,}04}=6{,}5\\ \\text{m/s}"
   },
   {
    "t": "p",
    "text": "Burgut janubi-g‘arb tomonga uchmoqda."
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**D)** 6,5"
     }
    ]
   }
  ],
  "4": [
   {
    "t": "p",
    "text": "Keplerning uchinchi qonuni: $T^2\\propto r^3$. Davr 8 marta ortsa, $r$ 4 marta ortadi. Orbital tezlik $v=\\sqrt{GM/r}$:"
   },
   {
    "t": "math",
    "tex": "\\frac{v_2}{v_1}=\\sqrt{\\frac{r_1}{r_2}}=\\frac12"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**C)** 2 marta kamayadi"
     }
    ]
   }
  ],
  "5": [
   {
    "t": "p",
    "text": "Bir jinsli g‘o‘laning og‘irlik markazi o‘rtasida. Ikkinchi uchiga nisbatan momentlar qoidasi:"
   },
   {
    "t": "math",
    "tex": "F\\cdot L=mg\\cdot\\frac L2\\;\\Rightarrow\\;F=\\frac{mg}{2}=\\frac{18\\,000}{2}=9000\\ \\text{N}=9\\ \\text{kN}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**B)** 9"
     }
    ]
   }
  ],
  "6": [
   {
    "t": "given",
    "blocks": [
     {
      "t": "p",
      "text": "$m=6$ kg, $F=3$ N, $t=3$ min $=180$ s, $v_0=0$"
