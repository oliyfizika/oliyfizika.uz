  "16": [
   {
    "t": "p",
    "text": "Sistema kinetik energiyasi zarralar eng yaqinlashganda, ya’ni tezliklari tenglashganda eng kichik bo‘ladi. Impuls saqlanadi:"
   },
   {
    "t": "math",
    "tex": "3mv_0=5mu\\;\\Rightarrow\\;u=\\frac35v_0"
   },
   {
    "t": "math",
    "tex": "E_{\\min}=\\frac{5mu^2}{2}=\\frac{5m}{2}\\cdot\\frac{9v_0^2}{25}=\\frac35\\cdot\\frac{3mv_0^2}{2}=0{,}6E"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**A)** 0,6E"
     }
    ]
   }
  ],
  "17": [
   {
    "t": "p",
    "text": "Zaryadlar: $W=\\frac{q^2}{2C}$ dan"
   },
   {
    "t": "math",
    "tex": "q_1=\\sqrt{2WC},\\qquad q_2=\\sqrt{2\\cdot3W\\cdot2C}=2\\sqrt{3WC}"
   },
   {
    "t": "p",
    "text": "Bir xil qutblar ulanganda zaryadlar qo‘shiladi, sig‘im $3C$:"
   },
   {
    "t": "math",
    "tex": "W'=\\frac{(q_1+q_2)^2}{2\\cdot3C}=\\frac{(\\sqrt2+2\\sqrt3)^2}{6}W=\\frac{14+4\\sqrt6}{6}W=\\frac{7+2\\sqrt6}{3}W"
   },
   {
    "t": "math",
    "tex": "Q=(W+3W)-W'=\\frac{12-7-2\\sqrt6}{3}W=\\frac{(5-2\\sqrt6)W}{3}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**B)** (5 − 2√6)W/3"
     }
    ]
   }
  ],
  "18": [
