   },
   {
    "t": "math",
    "tex": "a=\\frac Fm=0{,}5\\ \\text{m/s}^2,\\qquad s=\\frac{at^2}{2}=\\frac{0{,}5\\cdot32\\,400}{2}=8100\\ \\text{m}"
   },
   {
    "t": "math",
    "tex": "A=Fs=3\\cdot8100=24\\,300\\ \\text{J}=24{,}3\\ \\text{kJ}"
