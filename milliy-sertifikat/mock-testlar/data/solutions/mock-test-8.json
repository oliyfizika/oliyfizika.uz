   {
    "t": "math",
    "tex": "v^2=v_0^2-2g\\cdot\\frac89H=v_0^2-\\frac89v_0^2=\\frac{v_0^2}{9}\\;\\Rightarrow\\;v=\\frac{v_0}{3}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**B)** 3"
     }
