  "26": [
   {
    "t": "p",
    "text": "Ideal konturda elektr maydonning maksimal energiyasi magnit maydonning maksimal energiyasiga teng:"
   },
   {
    "t": "math",
    "tex": "\\frac{LI_m^2}{2}=W\\;\\Rightarrow\\;L=\\frac{2W}{I_m^2}=\\frac{2\\cdot0{,}16}{100}=3{,}2\\cdot10^{-3}\\ \\text{H}=3{,}2\\ \\text{mH}"
