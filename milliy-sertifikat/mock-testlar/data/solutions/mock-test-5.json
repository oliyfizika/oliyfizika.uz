  ],
  "22": [
   {
    "t": "p",
    "text": "K tugunidan chap yuqori tugungacha $3C$ kondensatorga ($4C$ va $12C$ ketma-ket) parallel ulangan. L dan o‘ng yuqori tugungacha $8C$ ga ($20C$ va $5C$ ketma-ket) parallel ulangan:"
   },
   {
    "t": "math",
    "tex": "C_{\\text{chap}}=3C+3C=6C,\\qquad C_{\\text{o'ng}}=8C+4C=12C"
   },
   {
    "t": "p",
    "text": "Ular yuqoridagi $12C$ bilan ketma-ket:"
   },
   {
    "t": "math",
    "tex": "\\frac1{C_{KL}}=\\frac1{6C}+\\frac1{12C}+\\frac1{12C}=\\frac1{3C}\\;\\Rightarrow\\;C_{KL}=3C"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**A)** $3C$"
     }
    ]
   }
  ],
  "23": [
   {
    "t": "math",
    "tex": "F=IBl\\sin\\alpha\\;\\Rightarrow\\;l=\\frac{F}{IB\\sin60^\\circ}=\\frac{0{,}9}{6\\cdot1{,}2\\cdot0{,}866}\\approx0{,}144\\ \\text{m}=14{,}4\\ \\text{cm}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**A)** 14,4 cm"
     }
    ]
   }
  ],
  "24": [
   {
    "t": "math",
    "tex": "C=\\frac{\\varepsilon_0S}{d}:\\ d\\to4d\\;\\Rightarrow\\;C\\to\\frac C4,\\qquad \\nu=\\frac1{2\\pi\\sqrt{LC}}\\to2\\nu=32\\ \\text{kHz}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**B)** 32 kHz"
