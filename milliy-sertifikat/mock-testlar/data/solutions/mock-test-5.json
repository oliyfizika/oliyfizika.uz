   },
   {
    "t": "math",
    "tex": "\\nu=\\frac{A+E_k}{h}\\approx\\frac{3{,}07\\cdot10^{-17}}{6{,}63\\cdot10^{-34}}\\approx4{,}6\\cdot10^{16}\\ \\text{Hz}"
   },
