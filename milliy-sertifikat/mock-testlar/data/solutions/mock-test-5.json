  "21": [
   {
    "t": "p",
    "text": "Kondensator manbaga ulangan, kuchlanish o‘zgarmaydi. Kerosin quyilganda sig‘im $\\varepsilon=2$ marta ortadi:"
   },
   {
    "t": "math",
    "tex": "W=\\frac{CU^2}{2}\\;\\Rightarrow\\;W'=2W=10\\ \\mu\\text{J}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**C)** 10 μJ"
     }
    ]
