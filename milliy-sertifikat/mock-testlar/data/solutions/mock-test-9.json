  "6": [
   {
    "t": "given",
    "blocks": [
     {
      "t": "p",
      "text": "$R=30$ cm, $h=20$ cm, kuch markazga gorizontal qo‘yilgan"
     }
    ]
   },
   {
    "t": "p",
    "text": "G‘o‘la zinapoya qirrasi atrofida aylanib ko‘tariladi. Qirraga nisbatan kuchlar yelkalari: gorizontal kuch uchun vertikal masofa $R-h=10$ cm, og‘irlik kuchi uchun gorizontal masofa:"
   },
   {
    "t": "math",
    "tex": "x=\\sqrt{R^2-(R-h)^2}=\\sqrt{900-100}=20\\sqrt2\\ \\text{cm}"
   },
   {
    "t": "p",
    "text": "Momentlar qoidasi:"
   },
   {
    "t": "math",
    "tex": "F(R-h)=mg\\,x\\;\\Rightarrow\\;F=mg\\frac{20\\sqrt2}{10}=2\\sqrt2\\,mg"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**B)** 2√2·mg"
     }
    ]
   }
  ],
  "7": [
   {
    "t": "given",
    "blocks": [
     {
      "t": "p",
      "text": "$R=10$ Ω, $R_V=500$ Ω"
     }
    ]
   },
   {
    "t": "p",
    "text": "Parallel ulanganda rezistor va voltmetrning umumiy qarshiligi $R_{\\parallel}=\\frac{10\\cdot500}{510}\\approx9{,}80$ Ω. Voltmetr ko‘rsatishlari:"
   },
   {
    "t": "math",
    "tex": "U_1=\\frac{\\varepsilon R_{\\parallel}}{R_{\\parallel}+r},\\qquad U_2=\\frac{\\varepsilon R_V}{R+R_V+r}"
   },
   {
    "t": "math",
    "tex": "U_1=U_2\\;\\Rightarrow\\;R_{\\parallel}(510+r)=500(R_{\\parallel}+r)\\;\\Rightarrow\\;r=\\frac{10R_{\\parallel}}{500-R_{\\parallel}}=\\frac{98{,}04}{490{,}2}=0{,}2\\ \\Omega"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**A)** 0,2"
     }
    ]
   }
  ],
  "8": [
   {
    "t": "p",
    "text": "Panjara formulasi $d\\sin\\varphi=k\\lambda$, $\\sin\\varphi\\le1$ dan:"
   },
   {
    "t": "math",
    "tex": "k\\le\\frac d\\lambda=2\\;\\Rightarrow\\;k=0,\\ \\pm1,\\ \\pm2"
