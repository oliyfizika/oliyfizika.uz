    "t": "math",
    "tex": "F(R-h)=mg\\,d\\;\\Rightarrow\\;F=mg\\frac{20\\sqrt2}{10}=2\\sqrt2\\,mg"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**B)** $2\\sqrt2\\,mg$"
     }
    ]
   }
