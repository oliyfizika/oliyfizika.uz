  "21": [
   {
    "t": "p",
    "text": "Tugunlarni belgilaymiz: kirish A (yuqori chap) va B (pastki chap), yuqori o‘rta C, yuqori o‘ng D, pastki o‘rta E, pastki o‘ng F. Barcha rezistorlar $R$: AB, AC, CD, CE, AE, ED, DF, BE, EF."
   },
   {
    "t": "p",
    "text": "Sxemani o‘ng tomondan soddalashtiramiz:"
   },
   {
    "t": "math",
    "tex": "D\\!-\\!F\\!-\\!E:\\ 2R\\parallel R_{ED}=\\tfrac23R;\\qquad C\\!-\\!D\\!-\\!E:\\ \\left(R+\\tfrac23R\\right)\\parallel R_{CE}=\\tfrac58R"
   },
   {
    "t": "math",
    "tex": "A\\!-\\!C\\!-\\!E:\\ \\left(R+\\tfrac58R\\right)\\parallel R_{AE}=\\tfrac{13}{21}R;\\qquad A\\!-\\!E\\!-\\!B:\\ \\left(\\tfrac{13}{21}R+R\\right)\\parallel R_{AB}=\\tfrac{34}{55}R"
   },
   {
    "t": "math",
    "tex": "R_{\\text{um}}=\\frac{34}{55}\\cdot5{,}5=3{,}4\\ \\Omega"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**C)** 3,4 Ω"
     }
    ]
   }
  ],
