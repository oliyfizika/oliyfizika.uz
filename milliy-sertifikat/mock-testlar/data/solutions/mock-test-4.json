  "11": [
   {
    "t": "p",
    "text": "Grafikda $p$ = const (izobarik), $V\\propto T$:"
   },
   {
    "t": "math",
    "tex": "\\frac{V_2}{V_1}=\\frac{900}{300}=3,\\quad V_2-V_1=2V_1=6\\;\\Rightarrow\\;V_1=3\\ \\text{m}^3"
