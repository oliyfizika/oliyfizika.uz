    "tex": "p=\\frac{p_1V_1+p_2V_2}{V_1+V_2}=\\frac{24\\cdot10^5+11\\cdot10^5}{7}=5\\cdot10^5\\ \\text{Pa}=500\\ \\text{kPa}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**D)** 500 kPa"
