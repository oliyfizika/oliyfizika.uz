{
 "schemaVersion": 1,
 "testId": "mock-test-12",
 "items": {
  "1": [
   {
    "t": "p",
    "text": "Grafikda koordinata vaqtga chiziqli bog‘liq: $x=x_0+vt$, bunda $v=\\operatorname{tg}\\alpha$ (grafik qiyaligi) o‘zgarmas. Tezlik o‘zgarmas bo‘lsa, harakat tekis bo‘ladi."
   },
   {
    "t": "math",
    "tex": "a=\\frac{\\Delta v}{\\Delta t}=0"
   },
   {
    "t": "p",
    "text": "$\\sin58^\\circ$, $\\cos58^\\circ$ qiymatlari tezlikni topish uchun kerak bo‘lishi mumkin, lekin tezlanishga ta’sir qilmaydi."
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**D)** 0"
     }
    ]
   }
  ],
  "2": [
   {
    "t": "given",
    "blocks": [
     {
      "t": "p",
      "text": "$a=0{,}4$ m/s², $s=100$ m, $t=20$ s"
     }
    ]
   },
   {
    "t": "math",
    "tex": "s=v_0t+\\frac{at^2}{2}\\;\\Rightarrow\\;100=20v_0+\\frac{0{,}4\\cdot400}{2}=20v_0+80\\;\\Rightarrow\\;v_0=1\\ \\text{m/s}"
   },
   {
    "t": "math",
    "tex": "v=v_0+at=1+0{,}4\\cdot20=9\\ \\text{m/s}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**B)** 1; 9"
     }
    ]
   }
  ],
  "3": [
   {
    "t": "given",
    "blocks": [
     {
      "t": "p",
      "text": "$\\alpha=45^\\circ$, $t_1=0{,}8$ s da $v_y=12$ m/s (jism hali ko‘tarilmoqda), $g=10$ m/s²"
     }
    ]
   },
   {
    "t": "math",
    "tex": "v_{0y}=v_y+gt_1=12+8=20\\ \\text{m/s},\\qquad v_{0x}=v_{0y}=20\\ \\text{m/s}\\ (45^\\circ)"
   },
   {
    "t": "math",
    "tex": "t_{\\text{uch}}=\\frac{2v_{0y}}{g}=4\\ \\text{s},\\qquad L=v_{0x}t_{\\text{uch}}=20\\cdot4=80\\ \\text{m}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**D)** 80"
     }
    ]
   }
  ],
  "4": [
   {
    "t": "p",
    "text": "Ko‘tarilish va tushish vaqtlari teng: $t_{\\text{k}}=12/2=6$ s."
   },
   {
    "t": "math",
    "tex": "h_{\\max}=\\frac{gt_{\\text{k}}^2}{2}=\\frac{10\\cdot36}{2}=180\\ \\text{m}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**C)** 180"
     }
    ]
   }
  ],
  "5": [
   {
    "t": "math",
    "tex": "F=\\sqrt{15^2+20^2}=25\\ \\text{N},\\quad a=\\frac{F}{m}=10\\ \\text{m/s}^2,\\quad v=at=30\\ \\text{m/s}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**B)** 30 m/s"
     }
    ]
   }
  ],
  "6": [
   {
    "t": "given",
    "blocks": [
     {
      "t": "p",
      "text": "$m_1=3$ kg (harakatlanuvchi blokda), $m_2=6$ kg (qo‘zg‘almas blok orqali ipga osilgan)"
     }
    ]
   },
   {
    "t": "p",
    "text": "$m_1$ osilgan harakatlanuvchi blokni ipning ikki tarmog‘i ushlab turadi, shuning uchun $a_2=2a_1$. Muvozanat uchun $m_2=m_1/2$ bo‘lishi kerak edi, $m_2$ og‘irroq, demak $m_2$ pastga, $m_1$ yuqoriga harakatlanadi:"
   },
   {
    "t": "math",
    "tex": "m_2g-T=m_2\\cdot2a_1,\\qquad 2T-m_1g=m_1a_1"
   },
   {
    "t": "math",
    "tex": "2m_2(g-2a_1)-m_1g=m_1a_1\\;\\Rightarrow\\;a_1=\\frac{(2m_2-m_1)g}{4m_2+m_1}=\\frac{9\\cdot10}{27}\\approx3{,}3\\ \\text{m/s}^2"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**C)** 3,3"
     }
    ]
   }
  ],
  "7": [
   {
    "t": "math",
    "tex": "\\frac{P_\\uparrow}{P_\\downarrow}=\\frac{m(g+a)}{m(g-a)}=\\frac{12}{8}=1{,}5"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**A)** 1,5"
     }
    ]
   }
  ],
  "8": [
   {
    "t": "given",
    "blocks": [
     {
      "t": "p",
      "text": "$m=0{,}15$ kg, $v=20$ m/s, normalga $60^\\circ$ burchak, $\\Delta t=0{,}01$ s, urilish elastik"
     }
    ]
   },
   {
    "t": "p",
    "text": "Elastik urilishda tezlikning faqat normal tashkil etuvchisi ishorasini o‘zgartiradi:"
   },
   {
    "t": "math",
    "tex": "\\Delta p=2mv\\cos60^\\circ=2\\cdot0{,}15\\cdot20\\cdot0{,}5=3\\ \\text{kg·m/s}"
   },
   {
    "t": "math",
    "tex": "F=\\frac{\\Delta p}{\\Delta t}=\\frac{3}{0{,}01}=300\\ \\text{N}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**C)** 300"
     }
    ]
   }
  ],
  "9": [
   {
    "t": "given",
    "blocks": [
     {
      "t": "p",
      "text": "$m=0{,}01$ kg, $v=100$ m/s, $M=1{,}99$ kg, $k=200$ N/m"
     }
    ]
   },
   {
    "t": "p",
    "text": "Noelastik urilishda impuls saqlanadi:"
   },
   {
    "t": "math",
    "tex": "u=\\frac{mv}{m+M}=\\frac{0{,}01\\cdot100}{2}=0{,}5\\ \\text{m/s}"
   },
   {
    "t": "p",
    "text": "Keyin kinetik energiya prujina energiyasiga aylanadi:"
   },
   {
    "t": "math",
    "tex": "\\frac{(m+M)u^2}{2}=\\frac{kx^2}{2}\\;\\Rightarrow\\;x=u\\sqrt{\\frac{m+M}{k}}=0{,}5\\sqrt{\\frac{2}{200}}=0{,}05\\ \\text{m}=5\\ \\text{sm}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**A)** 5"
     }
    ]
   }
  ],
  "10": [
   {
    "t": "p",
    "text": "O‘rtacha kvadratik tezlik $v=\\sqrt{3p/\\rho}$. Ikkinchi gaz zichligi $\\rho_2=2/10=0{,}2$ kg/m³:"
   },
   {
    "t": "math",
    "tex": "\\frac{v_2}{v_1}=\\sqrt{\\frac{p_2/\\rho_2}{p_1/\\rho_1}}=\\sqrt{\\frac{200\\cdot10^3/0{,}2}{400\\cdot10^3/1{,}6}}=\\sqrt{\\frac{10^6}{2{,}5\\cdot10^5}}=2"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**B)** 2"
     }
    ]
   }
  ],
  "11": [
   {
    "t": "given",
    "blocks": [
     {
      "t": "p",
      "text": "$V_1=2$ l, $p_1=12\\cdot10^5$ Pa; $V_2=5$ l, $p_2=2{,}2\\cdot10^5$ Pa; $T$ = const"
