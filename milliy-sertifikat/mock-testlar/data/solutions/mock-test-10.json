{
 "schemaVersion": 1,
 "testId": "mock-test-10",
 "items": {
  "1": [
   {
    "t": "p",
    "text": "Yo‘l tezlik grafigi ostidagi yuzaga teng. Grafik — trapetsiya (asoslari 12 s va 4 s, balandligi 8 m/s):"
   },
   {
    "t": "math",
    "tex": "s=\\frac{12+4}{2}\\cdot8=64\\ \\text{m}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**D)** 64"
     }
    ]
   }
  ],
  "2": [
   {
    "t": "p",
    "text": "Velosipedchi qirg‘oqda oqimga qarshi 9 m/s tezlik bilan harakatlanmoqda, kater unga nisbatan tinch — demak katerning qirg‘oqqa nisbatan tezligi ham oqimga qarshi 9 m/s. Oqim katerni orqaga 6 m/s bilan olib ketadi:"
   },
   {
    "t": "math",
    "tex": "v_{\\text{suvga nis.}}=v_{\\text{qirg'oqqa nis.}}+v_{\\text{oqim}}=9+6=15\\ \\text{m/s}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**D)** 15"
     }
    ]
   }
  ],
  "3": [
   {
    "t": "math",
    "tex": "g=\\frac{GM}{R^2}\\;\\Rightarrow\\;g'=g\\cdot\\frac{4}{(1/2)^2}=10\\cdot16=160\\ \\text{m/s}^2"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**B)** 160"
     }
    ]
   }
  ],
  "4": [
   {
    "t": "p",
    "text": "Birinchi jism otilgandan $t$ vaqt o‘tgach koordinatalar teng bo‘ladi ($\\tau=6$ s):"
   },
   {
    "t": "math",
    "tex": "v_0t-\\frac{gt^2}{2}=v_0(t-\\tau)-\\frac{g(t-\\tau)^2}{2}\\;\\Rightarrow\\;t=\\frac{v_0}{g}+\\frac\\tau2=\\frac{25}{5/3}+3=18\\ \\text{s}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**C)** 18"
     }
    ]
   }
  ],
  "5": [
   {
    "t": "p",
    "text": "Ish $p$–$V$ grafigi ostidagi trapetsiya yuziga teng:"
   },
   {
    "t": "math",
    "tex": "A=\\frac{p_A+p_B}{2}(V_B-V_A)=\\frac{8+12}{2}\\cdot10^6\\cdot4\\cdot10^{-3}=4\\cdot10^4\\ \\text{J}=40\\ \\text{kJ}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**D)** 40"
     }
    ]
   }
  ],
  "6": [
   {
    "t": "given",
    "blocks": [
     {
      "t": "p",
      "text": "$m_1=2$ kg, $m_2=5$ kg, $m_3=3$ kg (stolda, ishqalanishsiz)"
     }
    ]
   },
   {
    "t": "p",
    "text": "$m_2$ og‘irroq, u pastga, $m_1$ yuqoriga harakatlanadi:"
   },
   {
    "t": "math",
    "tex": "a=\\frac{(m_2-m_1)g}{m_1+m_2+m_3}=\\frac{3\\cdot10}{10}=3\\ \\text{m/s}^2"
   },
   {
    "t": "math",
    "tex": "T_I=m_1(g+a)=2\\cdot13=26\\ \\text{N},\\qquad T_{II}=m_2(g-a)=5\\cdot7=35\\ \\text{N}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**C)** T_I = 26 N; T_II = 35 N"
     }
    ]
   }
  ],
  "7": [
   {
    "t": "given",
    "blocks": [
     {
      "t": "p",
      "text": "Kerosinda $a_1=4$ m/s², $\\rho_s=1$ g/cm³, $\\rho_k=0{,}8$ g/cm³ (qarshilik hisobga olinmaydi)"
     }
    ]
   },
   {
    "t": "math",
    "tex": "ma=mg-\\rho_cVg\\;\\Rightarrow\\;a=g\\left(1-\\frac{\\rho_c}{\\rho}\\right)"
   },
   {
    "t": "math",
    "tex": "4=10\\left(1-\\frac{0{,}8}{\\rho}\\right)\\;\\Rightarrow\\;\\rho=\\frac43\\ \\text{g/cm}^3"
   },
   {
    "t": "math",
    "tex": "a_2=10\\left(1-\\frac{1}{4/3}\\right)=2{,}5\\ \\text{m/s}^2"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**D)** 2,5"
     }
    ]
   }
  ],
  "8": [
   {
    "t": "given",
    "blocks": [
     {
      "t": "p",
      "text": "$k=2$ kN/m, $m_1=4$ kg, $m_2=6$ kg, $\\mu=0{,}1$, $F=80$ N ($m_2$ ga)"
     }
    ]
   },
   {
    "t": "math",
    "tex": "a=\\frac{F-\\mu(m_1+m_2)g}{m_1+m_2}=\\frac{80-10}{10}=7\\ \\text{m/s}^2"
   },
   {
    "t": "p",
    "text": "Prujina $m_1$ ni tortadi:"
   },
   {
    "t": "math",
    "tex": "kx=m_1(a+\\mu g)=4\\cdot8=32\\ \\text{N}\\;\\Rightarrow\\;x=\\frac{32}{2000}=0{,}016\\ \\text{m}=1{,}6\\ \\text{cm}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**C)** 1,6"
     }
    ]
   }
  ],
  "9": [
   {
    "t": "p",
    "text": "Pastga $a=0{,}36g$ tezlanish bilan tushayotgan liftda effektiv erkin tushish tezlanishi $g'=g-a=0{,}64g$:"
   },
   {
    "t": "math",
    "tex": "\\frac{T'}{T}=\\sqrt{\\frac{g}{g'}}=\\frac{1}{0{,}8}=1{,}25"
   },
   {
    "t": "p",
    "text": "Davr 25 % ga ortadi."
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**A)** 25"
     }
    ]
   }
  ],
  "10": [
   {
    "t": "p",
    "text": "Grafikda 1→2 izobarik jarayon: $V/T$ = const. Hajm 2 marta ortgan, demak temperatura ham 2 marta ortgan:"
   },
   {
    "t": "math",
    "tex": "T_2=2T_1,\\qquad \\Delta T=T_2-T_1=T_1=330\\ \\text{K}"
   },
   {
    "t": "p",
    "text": "(Temperatura o‘zgarishi °C va K da bir xil.)"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**D)** 330"
     }
    ]
   }
  ],
  "11": [
   {
    "t": "math",
    "tex": "v=\\sqrt{\\frac{3p}{\\rho}}=\\sqrt{\\frac{3\\cdot16\\,000}{1{,}2}}=\\sqrt{40\\,000}=200\\ \\text{m/s}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**D)** 200"
     }
    ]
   }
  ],
  "12": [
   {
    "t": "p",
    "text": "Sistema o‘zgarmas tezlik bilan harakatlanmoqda, tezlanish nol. Bosim tinch holatdagidek:"
   },
   {
    "t": "math",
    "tex": "p=\\frac{mg}{S}=\\frac{40}{10\\cdot10^{-4}}=4\\cdot10^4\\ \\text{Pa}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**C)** 4·10⁴"
     }
    ]
   }
  ],
  "13": [
   {
    "t": "p",
    "text": "Grafikdan sig‘imlar: $C_x=\\frac{8}{8}=1$ F, $C_y=\\frac{4}{16}=0{,}25$ F. Sxemada ular parallel:"
   },
   {
    "t": "math",
    "tex": "C=C_x+C_y=1{,}25\\ \\text{F},\\qquad q=CU=1{,}25\\cdot100=125\\ \\text{C}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**D)** q = 125 C"
     }
    ]
   }
  ],
  "14": [
   {
    "t": "given",
    "blocks": [
     {
      "t": "p",
      "text": "Sterjen teng bo‘laklarga bo‘lingan, $V_L=10$ cm³, $\\rho_L=4$ g/cm³, $\\rho_s=1$ g/cm³"
     }
    ]
   },
   {
    "t": "p",
    "text": "Rasmdan: $K$ jism $O$ dan 2 bo‘lak chapda, $L$ jism 3 bo‘lak o‘ngda osilgan. $L$ suvda, unga Arximed kuchi ta’sir qiladi:"
   },
   {
    "t": "math",
    "tex": "m_L=40\\ \\text{g},\\qquad F_L=(m_L-\\rho_sV_L)g=(40-10)g=30g"
   },
   {
    "t": "math",
    "tex": "m_Kg\\cdot2=30g\\cdot3\\;\\Rightarrow\\;m_K=45\\ \\text{g}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**C)** 45"
     }
    ]
   }
  ],
  "15": [
   {
    "t": "given",
    "blocks": [
     {
      "t": "p",
      "text": "$B=15$ mT, $l=0{,}25$ m, $R=0{,}5$ Ω, $v=36$ km/h $=10$ m/s"
     }
    ]
   },
   {
    "t": "math",
    "tex": "\\varepsilon=Blv=15\\cdot10^{-3}\\cdot0{,}25\\cdot10=0{,}0375\\ \\text{V}"
   },
   {
    "t": "math",
    "tex": "I=\\frac{\\varepsilon}{R}=\\frac{0{,}0375}{0{,}5}=0{,}075\\ \\text{A}=75\\ \\text{mA}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**D)** 75"
     }
    ]
   }
  ],
  "16": [
   {
    "t": "p",
    "text": "$C_1$ va $C_2$ parallel — kuchlanishlari bir xil:"
   },
   {
    "t": "math",
    "tex": "U_1=\\frac{q_1}{C_1}=\\frac{12}{6}=2\\ \\text{V},\\qquad q_2=C_2U_1=4\\ \\text{nC}"
   },
   {
    "t": "p",
    "text": "$C_3$ ularga ketma-ket ulangan, uning zaryadi parallel guruhning umumiy zaryadiga teng:"
   },
   {
    "t": "math",
    "tex": "q_3=q_1+q_2=16\\ \\text{nC}"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**D)** 16"
     }
    ]
   }
  ],
  "17": [
   {
    "t": "math",
    "tex": "I=\\frac UR=\\frac{18}{6}=3\\ \\text{A},\\qquad r=\\frac{\\varepsilon-U}{I}=\\frac{30-18}{3}=4\\ \\Omega"
   },
   {
    "t": "answer",
    "blocks": [
     {
      "t": "p",
      "text": "**B)** 4"
     }
    ]
   }
  ],
  "18": [
   {
    "t": "p",
    "text": "Tarmoq kuchlanishi o‘zgarmas, $Q=\\frac{U^2}{R}t$. Parallel ulanganda $R_1=R/3$, ketma-ket ulanganda $R_2=3R$:"
   },
   {
    "t": "math",
    "tex": "\\frac{t_2}{t_1}=\\frac{R_2}{R_1}=9\\;\\Rightarrow\\;t_2=9\\cdot40=360\\ \\text{s}=6\\ \\text{minut}"
   },
   {
    "t": "answer",
    "blocks": [
